<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_leave_history">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <h3>My Leave History</h3>

            <t t-if="leaves">
                <table class="table table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Format</th>
                            <th>Total Days</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="leaves" t-as="leave">
                            <tr>
                                <td><t t-esc="leave.start_date"/></td>
                                <td><t t-esc="leave.end_date"/></td>
                                <td><t t-esc="leave.leave_format"/></td>
                                <td><t t-esc="leave.total_leave_days"/></td>
                                <td>
                                    <span class="badge bg-info">
                                        <t t-esc="leave.status"/>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <t t-if="not leaves">
                <p>No leave records found.</p>
            </t>
        </div>
    </t>
</template>

</odoo>