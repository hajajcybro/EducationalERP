<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_published_scholarships">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2 class="mb-4">Published Scholarships</h2>

                <t t-if="scholarships">
                    <div class="row">
                        <t t-foreach="scholarships" t-as="sch">
                            <div class="col-md-6 mb-4">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body">
                                        <!-- Title -->
                                        <h5 class="card-title mb-3">
                                            <t t-esc="sch.name"/>
                                        </h5>
                                        <!-- Basic Info -->
                                        <p class="mb-1">
                                            <strong>Amount:</strong>
                                            <t t-esc="sch.scholarship_amount"/>
                                        </p>
                                        <t t-if="sch.number_of_awards &gt; 0">
                                            <p class="mb-1">
                                                <strong>Awards:</strong>
                                                <t t-esc="sch.number_of_awards"/>
                                            </p>
                                        </t>
                                        <p class="mb-1">
                                            <strong>Duration:</strong>
                                            <t t-esc="sch.application_duration"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Deadline:</strong>
                                            <t t-esc="sch.end_date"/>
                                        </p>
                                        <!-- Read More Button -->
                                        <a class="btn btn-sm btn-outline-primary mt-2"
                                           data-bs-toggle="collapse"
                                           t-attf-href="#details_#{sch.id}"
                                           role="button">
                                            Read More
                                        </a>
                                        <!-- Collapsible Section -->
                                        <div class="collapse mt-3"
                                             t-attf-id="details_#{sch.id}">
                                            <hr/>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <p>
                                                        <strong>Start Date:</strong>
                                                        <t t-esc="sch.start_date"/>
                                                    </p>
                                                </div>
                                                <div class="col-md-6">
                                                    <p>
                                                        <strong>Academic Year:</strong>
                                                        <t t-esc="sch.academic_year_id.name"/>
                                                    </p>
                                                </div>
                                            </div>
                                            <!-- Documents -->
                                            <t t-if="sch.document_type_ids">
                                                <h6 class="mt-3">Required Documents</h6>
                                                <ul class="mb-2">
                                                    <t t-foreach="sch.document_type_ids" t-as="doc">
                                                        <li>
                                                            <t t-esc="doc.name"/>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </t>
                                            <!-- Eligibility -->
                                            <t t-if="sch.eligibility_ids">
                                                <h6>Eligibility Criteria</h6>
                                                <ul class="mb-2">
                                                    <t t-foreach="sch.eligibility_ids" t-as="criteria">
                                                        <li>
                                                            <t t-esc="criteria.criteria_id.name"/>
                                                            (<t t-esc="criteria.operator"/>
                                                            <t t-esc="criteria.value"/>)
                                                        </li>
                                                    </t>
                                                </ul>
                                            </t>

                                            <!-- Description -->
                                            <t t-if="sch.description">
                                                <h6>Description</h6>
                                                <p class="text-muted">
                                                    <t t-esc="sch.description"/>
                                                </p>
                                            </t>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-else="">
                    <div class="alert alert-info">
                        No scholarships currently available.
                    </div>
                </t>

            </div>
        </t>
    </template>
</odoo>
