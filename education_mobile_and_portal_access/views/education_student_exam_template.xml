<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_published_exams">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <h3>Published Exams</h3>

            <table class="table table-striped mt-3">
                <thead>
                    <tr>
                        <th>Exam</th>
                        <th>Program</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="exams" t-as="exam">
                        <tr>
                            <td><t t-esc="exam.name"/></td>
                            <td><t t-esc="exam.program_id.name"/></td>
                            <td><t t-esc="exam.start_date"/></td>
                            <td><span class="badge bg-success">Published</span></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-if="not exams">
                <p class="text-muted mt-3">No published exams available.</p>
            </t>
        </div>
    </t>
</template>
</odoo>