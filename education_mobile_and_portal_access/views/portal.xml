<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_my_home_library_card"
          inherit_id="portal.portal_my_home">

    <xpath expr="//div[@id='portal_common_category']" position="inside">

        <div class="o_portal_index_card col-12 col-md-6 order-2">
            <a href="/my/library"
               class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                <div class="o_portal_icon">
                    <i class="fa fa-book fa-2x"/>
                </div>
                <div>
                    <h5 class="mb-1">Library</h5>
                    <small>View your library details</small>
                </div>
            </a>
        </div>
        <div class="o_portal_index_card col-12 col-md-6 order-2">
            <a href="/my/exams"
               class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                <div class="o_portal_icon">
                    <i class="fa fa-edit fa-2x"/>
                </div>
                <div>
                    <h5 class="mb-1">Exams</h5>
                    <small>View published exams and your results</small>
                </div>
            </a>
        </div>
        <div class="o_portal_index_card col-12 col-md-6 order-2">
            <a href="/my/attendance"
               class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                <div class="o_portal_icon">
                    <i class="fa fa-calendar-check-o fa-2x"/>
                </div>
                <div>
                    <h5 class="mb-1">Attendance</h5>
                    <small>View attendance and leave details</small>
                </div>
            </a>
        </div>
        <div class="o_portal_index_card col-12 col-md-6 order-2">
            <a href="/my/hostel"
               class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                <div class="o_portal_icon">
                    <i class="fa fa-building fa-2x"/>
                </div>
                <div>
                    <h5 class="mb-1">Hostel</h5>
                    <small>View Hostel and Payment history</small>
                </div>
            </a>
        </div>
        <div class="o_portal_index_card col-12 col-md-6 order-2">
            <a href="/my/scholarship"
               class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                <div class="o_portal_icon">
                    <i class="fa fa-graduation-cap fa-2x"/>
                </div>
                <div>
                    <h5 class="mb-1">Scholarships</h5>
                    <small>View scholarships and your applications</small>
                </div>
            </a>
        </div>
         <div class="o_portal_index_card col-12 col-md-6 order-2">
            <a href="/my/transport"
               class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                <div class="o_portal_icon">
                    <i class="fa fa-bus fa-2x"/>
                </div>
                <div>
                    <h5 class="mb-1">Transport</h5>
                    <small>View transport info</small>
                </div>
            </a>
        </div>

<!--        <div class="col-md-6 mb-3">-->
<!--            <a href="/my/exams" class="text-decoration-none">-->
<!--                <div class="card shadow-sm border-0 h-100">-->
<!--                    <div class="card-body">-->
<!--                        <h5 class="card-title">Exams</h5>-->
<!--                        <p class="card-text text-muted">-->
<!--                            View published exams and your results-->
<!--                        </p>-->
<!--                    </div>-->
<!--                </div>-->
<!--            </a>-->
<!--        </div>-->

    </xpath>

</template>



</odoo>

