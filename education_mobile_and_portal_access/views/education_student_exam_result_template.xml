<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<template id="portal_exam_results">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <h3>My Exam Results</h3>

            <t t-if="results">
                <t t-foreach="results" t-as="r">
                    <div class="card shadow-sm mb-4 p-3">

                        <h5 class="mb-2">
                            Exam: <t t-esc="r.exam_id.name"/>
                        </h5>

                        <p class="text-muted">
                            Total Marks: <strong><t t-esc="r.total_marks_scored"/></strong>
                            Result:
                            <span class="badge bg-success" t-if="r.overall_pass_fail">Pass</span>
                            <span class="badge bg-danger" t-if="not r.overall_pass_fail">Fail</span>
                        </p>

                        <table class="table table-sm table-striped mt-2">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Max Mark</th>
                                    <th>Pass Mark</th>
                                    <th>Mark Scored</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="r.result_line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.course_id.name"/></td>
                                        <td><t t-esc="line.max_mark"/></td>
                                        <td><t t-esc="line.pass_mark"/></td>
                                        <td><t t-esc="line.mark_scored"/></td>
                                        <td>
                                            <span class="badge bg-success" t-if="line.pass_fail">Pass</span>
                                            <span class="badge bg-danger" t-if="not line.pass_fail">Fail</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
            <t t-if="not results">
                <p class="text-muted">No exam results available.</p>
            </t>

        </div>
    </t>
</template>


</odoo>