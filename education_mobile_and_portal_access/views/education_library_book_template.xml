<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<template id="portal_library_books">
    <t t-call="portal.portal_layout">

        <div class="container">
            <h2 class="mb-4">Available Books</h2>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Authors</th>
                        <th>Available</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="books" t-as="book">
                        <tr>
                            <td>
                                <t t-esc="book.title"/>
                            </td>

                            <td>
                                <t t-esc="book.authors"/>
                            </td>

                            <td>
                                <t t-esc="book.copies_available"/>
                            </td>

                            <td>
                                <span t-if="book.copies_available &gt; 0"
                                      class="badge bg-success">
                                    Available
                                </span>
                                <span t-if="book.copies_available == 0"
                                      class="badge bg-danger">
                                    Not Available
                                </span>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

        </div>

    </t>
</template>

</odoo>