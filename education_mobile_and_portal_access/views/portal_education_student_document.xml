<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_add_document" name="Add Document">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3 class="mb-4">Upload Document</h3>
                <div class="card shadow-sm p-4">
                    <form action="/my/document/submit"
                          method="post"
                          enctype="multipart/form-data">
                        <input type="hidden"
                               name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label>Document Type</label>
                            <select name="document_type"
                                    class="form-control"
                                    required="1">
                                <option value="">Select Type</option>
                                <t t-foreach="doc_types" t-as="type">
                                    <option t-att-value="type.id">
                                        <t t-esc="type.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Upload File</label>
                            <input type="file"
                                   name="attachment"
                                   class="form-control"
                                   required="1"/>
                        </div>
                        <button type="submit"
                                class="btn btn-primary">
                            Submit
                        </button>
                        <a href="/my/profile"
                           class="btn btn-secondary">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
