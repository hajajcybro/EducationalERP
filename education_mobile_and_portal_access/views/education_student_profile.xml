<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_student_profile" name="Student Profile">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3 class="mb-4">My Profile</h3>
                <t t-if="request.params.get('message') == 'submitted'">
                    <div class="alert alert-info">
                        Your document has been submitted successfully.
                        It is waiting for approval.
                    </div>
                </t>
                <div class="card shadow-sm p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Admission No:</strong> <t t-esc="student.admission_no"/></p>
                            <p><strong>Academic Year:</strong> <t t-esc="student.academic_year_id.name"/></p>
                            <p><strong>Program:</strong> <t t-esc="student.program_id.name"/></p>
                            <p><strong>Class:</strong> <t t-esc="student.class_id.name"/></p>
                            <p><strong>Roll No:</strong> <t t-esc="student.roll_no"/></p>
                        </div>

                        <div class="col-md-6">
                            <p><strong>Father Name:</strong> <t t-esc="student.father_name"/></p>
                            <p><strong>Mother Name:</strong> <t t-esc="student.mother_name"/></p>
                            <p><strong>Guardian:</strong> <t t-esc="student.guardian"/></p>
                            <p><strong>Relation:</strong> <t t-esc="student.relation"/></p>
                            <p><strong>Date of Birth:</strong> <t t-esc="student.dob"/></p>
                            <p><strong>Age:</strong> <t t-esc="student.age"/></p>
                            <p><strong>Gender:</strong> <t t-esc="student.gender"/></p>
                            <p><strong>Blood Group:</strong> <t t-esc="student.blood_group"/></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm p-4 mb-4">
<!--                <h5 class="mb-3">My Documents</h5>-->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">My Documents</h5>

                    <a href="/my/document/update"
                       class="btn btn-success btn-sm">
                        + Add Document
                    </a>
                </div>
                <t t-if="documents">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Document Type</th>
                                <th>Uploaded Date</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="documents" t-as="doc">
                                <tr>
                                    <td>
                                        <t t-esc="doc.document_type.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="doc.issue_date"/>
                                    </td>
                                    <td>
                                        <t t-if="doc.state == 'approved'">
                                            <a t-att-href="'/my/document/download/%s' % doc.id"
                                               class="btn btn-sm btn-primary">
                                                Download
                                            </a>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <p class="text-muted">No documents uploaded.</p>
                </t>
            </div>
        </t>
    </template>
</odoo>
