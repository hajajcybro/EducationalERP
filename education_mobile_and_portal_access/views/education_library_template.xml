<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<template id="portal_library_home" name="Portal Library Home">
    <t t-call="portal.portal_layout">
        <div class="container">
            <h2 class="mb-4">Library</h2>
            <div class="row g-3">
                <!-- Books -->
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <a href="/my/library/books"
                           class="text-decoration-none p-4 d-block">
                            <h5>Books  Availability</h5>
                            <p>View all books and available status</p>
                        </a>
                    </div>
                </div>
                <!-- My History (Only if Member) -->
                <t t-if="is_member">
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <a href="/my/library/history"
                               class="text-decoration-none p-4 d-block">
                                <h5>My History</h5>
                                <p>Issued and returned books</p>
                            </a>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</template>
</odoo>