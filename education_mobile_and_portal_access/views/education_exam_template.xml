<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_exam_home">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <h2>Exams</h2>
            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <a href="/my/published-exams" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5>Published Exams</h5>
                                <p class="text-muted">View available exams</p>
                            </div>
                        </div>
                    </a>
                </div>

                <t t-if="is_student">
                    <div class="col-md-6 mb-3">
                        <a href="/my/exam-results" class="text-decoration-none">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body">
                                    <h5>My Results</h5>
                                    <p class="text-muted">View your results</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </t>
            </div>
        </div>
    </t>
</template>
</odoo>