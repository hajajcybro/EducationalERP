<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_exam_home">
    <t t-call="portal.portal_layout">
        <div class="container mt-4">
            <t t-if="alert_messages">
                <t t-foreach="alert_messages" t-as="msg">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="fa fa-bell me-2"/>
                        <t t-esc="msg"/>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                    </div>
                </t>
            </t>

            <h2>Exams</h2>
            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <a href="/my/published-exams" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <i class="fa fa-bullhorn fa-2x mb-3 text-primary"/>
                                <h5>Published Exams</h5>
                                <p class="text-muted">View available exams</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="/exam/revaluation" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <i class="fa fa-magnifying-glass fa-2x mb-3 text-success"/>
                                <h5>Revaluation</h5>
                                <p class="text-muted">revaluation application</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="/my/exam-results" class="text-decoration-none">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <i class="fa fa-clipboard-check fa-2x mb-3 text-success"/>
                                <h5>Exam Results</h5>
                                <p class="text-muted">View your results</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </t>
</template>
</odoo>