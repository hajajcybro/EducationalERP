<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.hostel.room
         (defined first — the property form references action_edu_hostel_room)
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- Room — Form -->
    <record id="view_edu_hostel_room_form" model="ir.ui.view">
        <field name="name">edu.hostel.room.form</field>
        <field name="model">edu.hostel.room</field>
        <field name="arch" type="xml">
            <form string="Hostel Room">
                <sheet>
                    <div class="oe_title">
                        <label for="room_no"/>
                        <h1>
                            <field name="room_no" placeholder="Room No."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Room Details">
                            <field name="property_id"/>
                            <field name="room_type"/>
                            <field name="capacity"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'available'"
                                   decoration-warning="state == 'occupied'"
                                   decoration-danger="state == 'maintenance'"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Amenities">
                        <field name="amenities" nolabel="1"
                               placeholder="List amenities e.g. AC, Wi-Fi, Attached Bathroom..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Room — List -->
    <record id="view_edu_hostel_room_list" model="ir.ui.view">
        <field name="name">edu.hostel.room.list</field>
        <field name="model">edu.hostel.room</field>
        <field name="arch" type="xml">
            <list string="Hostel Rooms">
                <field name="property_id"/>
                <field name="room_no"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <field name="state"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'occupied'"
                       decoration-danger="state == 'maintenance'"
                       widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Room — Search -->
    <record id="view_edu_hostel_room_search" model="ir.ui.view">
        <field name="name">edu.hostel.room.search</field>
        <field name="model">edu.hostel.room</field>
        <field name="arch" type="xml">
            <search string="Hostel Rooms">
                <field name="room_no"/>
                <field name="property_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="occupied" string="Occupied" domain="[('state', '=', 'occupied')]"/>
                <filter name="maintenance" string="Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <group>
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'room_type'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Room — Action -->
    <record id="action_edu_hostel_room" model="ir.actions.act_window">
        <field name="name">Hostel Rooms</field>
        <field name="res_model">edu.hostel.room</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_hostel_room_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add rooms to your hostel properties
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.hostel.property
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- Property — Form -->
    <record id="view_edu_hostel_property_form" model="ir.ui.view">
        <field name="name">edu.hostel.property.form</field>
        <field name="model">edu.hostel.property</field>
        <field name="arch" type="xml">
            <form string="Hostel Property">
                <sheet>
                    <!-- Stat buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_edu_hostel_room)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-bed"
                                context="{'default_property_id': id, 'search_default_property_id': id}">
                            <field name="room_count" widget="statinfo" string="Rooms"/>
                        </button>
                        <button name="action_view_allocations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"
                                context="{'default_property_id': id, 'search_default_property_id': id}">
                            <field name="occupied_count" widget="statinfo" string="Occupied"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Details">
                            <field name="block"/>
                            <field name="total_capacity"/>
                            <field name="warden_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rooms" name="rooms">
                            <field name="room_ids" mode="list">
                                <list>
                                    <field name="room_no"/>
                                    <field name="room_type"/>
                                    <field name="capacity"/>
                                    <field name="state"
                                           decoration-success="state == 'available'"
                                           decoration-warning="state == 'occupied'"
                                           decoration-danger="state == 'maintenance'"
                                           widget="badge"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Property — List -->
    <record id="view_edu_hostel_property_list" model="ir.ui.view">
        <field name="name">edu.hostel.property.list</field>
        <field name="model">edu.hostel.property</field>
        <field name="arch" type="xml">
            <list string="Hostel Properties">
                <field name="name"/>
                <field name="block"/>
                <field name="total_capacity"/>
                <field name="room_count"/>
                <field name="occupied_count"/>
                <field name="warden_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Property — Search -->
    <record id="view_edu_hostel_property_search" model="ir.ui.view">
        <field name="name">edu.hostel.property.search</field>
        <field name="model">edu.hostel.property</field>
        <field name="arch" type="xml">
            <search string="Hostel Properties">
                <field name="name"/>
                <field name="block"/>
                <field name="warden_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Property — Action -->
    <record id="action_edu_hostel_property" model="ir.actions.act_window">
        <field name="name">Hostel Properties</field>
        <field name="res_model">edu.hostel.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_hostel_property_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first hostel property
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.hostel.allocation
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- Allocation — Form -->
    <record id="view_edu_hostel_allocation_form" model="ir.ui.view">
        <field name="name">edu.hostel.allocation.form</field>
        <field name="model">edu.hostel.allocation</field>
        <field name="arch" type="xml">
            <form string="Hostel Allocation">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_vacate" string="Vacate"
                            type="object" class="btn-warning"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,vacated"/>
                </header>
                <sheet>
                    <group string="Student &amp; Room">
                        <group>
                            <field name="enrollment_id"/>
                            <field name="room_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Billing">
                        <field name="hostel_fee"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Additional notes about this allocation..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Allocation — List -->
    <record id="view_edu_hostel_allocation_list" model="ir.ui.view">
        <field name="name">edu.hostel.allocation.list</field>
        <field name="model">edu.hostel.allocation</field>
        <field name="arch" type="xml">
            <list string="Hostel Allocations"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'vacated'">
                <field name="enrollment_id"/>
                <field name="room_id"/>
                <field name="property_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="hostel_fee"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'vacated'"/>
            </list>
        </field>
    </record>

    <!-- Allocation — Search -->
    <record id="view_edu_hostel_allocation_search" model="ir.ui.view">
        <field name="name">edu.hostel.allocation.search</field>
        <field name="model">edu.hostel.allocation</field>
        <field name="arch" type="xml">
            <search string="Hostel Allocations">
                <field name="enrollment_id"/>
                <field name="room_id"/>
                <field name="property_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="vacated" string="Vacated" domain="[('state', '=', 'vacated')]"/>
                <separator/>
                <filter name="active_allocations" string="Active"
                        domain="[('state', 'in', ['draft', 'confirmed'])]"/>
                <group>
                    <filter name="group_by_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Allocation — Action -->
    <record id="action_edu_hostel_allocation" model="ir.actions.act_window">
        <field name="name">Hostel Allocations</field>
        <field name="res_model">edu.hostel.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_hostel_allocation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Allocate students to hostel rooms
            </p>
        </field>
    </record>

</odoo>
