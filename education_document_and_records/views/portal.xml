<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <template id="portal_my_home_library_card"
              inherit_id="portal.portal_my_home">
            <xpath expr="//div[@id='portal_common_category']" position="inside">
                <div class="o_portal_index_card col-12 col-md-6 order-2">
                    <a href="/my/document"
                       class="d-flex gap-3 p-3 pe-2 px-md-3 h-100 rounded text-decoration-none alert alert-primary align-items-center">
                        <div class="o_portal_icon">
                            <i class="fa fa-file fa-2x"/>
                        </div>
                        <div>
                            <h5 class="mb-1">My Document
                                <t t-if="unread_profile and unread_profile > 0">
                                    <span class="badge rounded-pill bg-danger ms-2"
                                          style="font-size: 0.7rem; vertical-align: middle;">
                                        <t t-esc="unread_profile"/> New
                                    </span>
                                </t>
                            </h5>
                            <small>Document Info</small>
                        </div>
                    </a>
                </div>
            </xpath>
    </template>
</odoo>

