<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_student_document" name="Student Profile">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <t t-if="alert_messages">
                    <div class="container mt-3">
                        <t t-foreach="alert_messages" t-as="msg">
                            <div class="alert alert-info alert-dismissible fade show" role="alert">
                                <i class="fa fa-bell me-2"/>
                                <t t-esc="msg"/>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-if="request.params.get('message') == 'submitted'">
                    <div class="alert alert-info">
                        Your document has been submitted successfully.
                        It is waiting for approval.
                    </div>
                </t>
            </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">My Documents</h5>
                    <a href="/my/document/update"
                       class="btn btn-success btn-sm">
                        + Add Document
                    </a>
                </div>
                <t t-if="documents">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Document Type</th>
                                <th>Uploaded Date</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="documents" t-as="doc">
                                <tr>
                                    <td>
                                        <t t-esc="doc.document_type.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="doc.issue_date"/>
                                    </td>
                                    <td>
                                        <t t-if="doc.state == 'approved'">
                                            <a t-att-href="'/my/document/download/%s' % doc.id"
                                               class="btn btn-sm btn-primary">
                                                Download
                                            </a>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <p class="text-muted">No documents uploaded.</p>
                </t>
        </t>
    </template>
</odoo>
