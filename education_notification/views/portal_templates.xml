<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_alumni_dashboard_inherit" inherit_id="education_core.portal_alumni_dashboard">
        <xpath expr="//div[@id='alumni_dashboard_cards']" position="inside">
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fa fa-bell fa-4x text-warning mb-3"></i>
                        <h4 class="card-title">Announcements</h4>
                        <p class="card-text text-muted">
                            You have <strong t-esc="unread_count"/> unread notifications.
                        </p>
                        <a href="/my/alumni/notifications" class="btn btn-outline-warning">View Notifications</a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>