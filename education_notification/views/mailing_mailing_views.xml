<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mailing_mailing_form_inherit_edu" model="ir.ui.view">
        <field name="name">mailing.mailing.form.inherit.edu</field>
        <field name="model">mailing.mailing</field>
        <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_edu_notification"
                        type="object"
                        string="Notification"
                        class="oe_stat_button"
                        icon="fa-bell"
                        invisible="not edu_notification_id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Education Notification"
                       invisible="not is_edu_notification">
                    <field name="edu_notification_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>