<odoo>
    <!-- Tree View -->
    <record id="view_edu_notification_list" model="ir.ui.view">
        <field name="name">edu.notification.list</field>
        <field name="model">edu.notification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="module"/>
                <field name="notification_type"/>
                <field name="status"/>
                <field name="scheduled_date"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_edu_notification_form" model="ir.ui.view">
        <field name="name">edu.notification.form</field>
        <field name="model">edu.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_send"
                            type="object"
                            string="Send"
                            class="btn-primary"
                            invisible="status not in ('draft','failed')"/>
                    <button class="btn btn-primary" name="action_open_marketing"
                            type="object"
                            string="View SMS/Email"
                            icon="fa-bullhorn"
                            invisible="not marketing_mailing_id"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,pending,sent,failed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="module"/>
                            <field name="notification_type"/>
                            <!--                            <field name="template_id"/>-->
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="created_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message" nolabel="1"/>
                        </page>
                        <page string="Recipients">
                            <group>
                                <group>
                                    <field name="class_id"/>
                                </group>
                                <group>
                                    <field name="recipient_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edu_notification_search" model="ir.ui.view">
        <field name="name">edu.notification.search</field>
        <field name="model">edu.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="module"/>
                <field name="notification_type"/>
                <field name="status"/>

                <filter name="pending" string="Pending"
                        domain="[('status','=','pending')]"/>
                <filter name="failed" string="Failed"
                        domain="[('status','=','failed')]"/>
                <filter name="sent" string="Sent"
                        domain="[('status','=','sent')]"/>
            </search>
        </field>
    </record>


    <!-- Action -->
    <record id="action_edu_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">edu.notification</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->

    <menuitem id="menu_edu_root"
              name="Notifications"
              sequence="10"/>
    <menuitem id="menu_edu_notification"
              name="Notifications"
              parent="menu_edu_root"
              sequence="10"/>

    <menuitem id="menu_notification_noti"
              name="Notifications"
              parent="menu_edu_notification"
              action="action_edu_notification"/>


</odoo>
