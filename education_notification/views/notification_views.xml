<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         edu.notification.queue
    ================================================================ -->

    <!-- Form view -->
    <record id="view_edu_notification_queue_form" model="ir.ui.view">
        <field name="name">edu.notification.queue.form</field>
        <field name="model">edu.notification.queue</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_send" type="object" string="Send"
                        class="btn-primary"
                        invisible="state != 'pending'"/>
                    <button name="action_retry" type="object" string="Retry"
                        class="btn-warning"
                        invisible="state != 'failed'"/>
                    <button name="action_mark_failed" type="object" string="Mark Failed"
                        class="btn-danger"
                        invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="pending,sent,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Addressing">
                            <field name="notif_type"/>
                            <field name="recipient_id"/>
                            <field name="template_id"
                                invisible="notif_type != 'email'"/>
                        </group>
                        <group string="Details">
                            <field name="subject"/>
                            <field name="retry_count"/>
                            <field name="sent_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body" placeholder="Notification body…"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_edu_notification_queue_list" model="ir.ui.view">
        <field name="name">edu.notification.queue.list</field>
        <field name="model">edu.notification.queue</field>
        <field name="arch" type="xml">
            <list string="Notification Queue" decoration-danger="state == 'failed'"
                  decoration-success="state == 'sent'"
                  decoration-muted="state == 'sent'">
                <field name="create_date" string="Created"/>
                <field name="notif_type" widget="badge"
                    decoration-info="notif_type == 'inapp'"
                    decoration-warning="notif_type == 'sms'"
                    decoration-primary="notif_type == 'email'"/>
                <field name="recipient_id"/>
                <field name="subject"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'sent'"
                    decoration-danger="state == 'failed'"
                    decoration-warning="state == 'pending'"/>
                <field name="sent_date"/>
                <field name="retry_count"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_edu_notification_queue_search" model="ir.ui.view">
        <field name="name">edu.notification.queue.search</field>
        <field name="model">edu.notification.queue</field>
        <field name="arch" type="xml">
            <search string="Search Notifications">
                <field name="recipient_id"/>
                <field name="subject"/>
                <filter name="filter_pending" string="Pending"
                    domain="[('state', '=', 'pending')]"/>
                <filter name="filter_sent" string="Sent"
                    domain="[('state', '=', 'sent')]"/>
                <filter name="filter_failed" string="Failed"
                    domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="filter_email" string="Email"
                    domain="[('notif_type', '=', 'email')]"/>
                <filter name="filter_sms" string="SMS"
                    domain="[('notif_type', '=', 'sms')]"/>
                <filter name="filter_inapp" string="In-App"
                    domain="[('notif_type', '=', 'inapp')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                        context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type"
                        context="{'group_by': 'notif_type'}"/>
                    <filter name="group_recipient" string="Recipient"
                        context="{'group_by': 'recipient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_edu_notification_queue" model="ir.actions.act_window">
        <field name="name">Notification Queue</field>
        <field name="res_model">edu.notification.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_notification_queue_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No notifications in queue yet.
            </p>
            <p>
                Create a notification to send it via email, SMS or in-app.
            </p>
        </field>
    </record>

    <!-- ================================================================
         edu.notification.centre
    ================================================================ -->

    <!-- Form view -->
    <record id="view_edu_notification_centre_form" model="ir.ui.view">
        <field name="name">edu.notification.centre.form</field>
        <field name="model">edu.notification.centre</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_mark_read" type="object" string="Mark as Read"
                        class="btn-primary"
                        invisible="is_read"/>
                </header>
                <sheet>
                    <group>
                        <group string="Notification">
                            <field name="user_id"/>
                            <field name="title"/>
                            <field name="notification_date"/>
                            <field name="is_read" widget="boolean_toggle"/>
                        </group>
                        <group string="Navigation">
                            <field name="link_model"/>
                            <field name="link_res_id"
                                invisible="not link_model"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message" placeholder="Notification message…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_edu_notification_centre_list" model="ir.ui.view">
        <field name="name">edu.notification.centre.list</field>
        <field name="model">edu.notification.centre</field>
        <field name="arch" type="xml">
            <list string="Notification Centre" decoration-muted="is_read">
                <field name="is_read" widget="badge"
                    decoration-success="is_read"
                    decoration-warning="not is_read"
                    string="Status"/>
                <field name="notification_date" string="Date"/>
                <field name="title"/>
                <field name="message" optional="show"/>
                <field name="user_id"/>
                <button name="action_mark_read" type="object" string="Mark Read"
                    icon="fa-check" invisible="is_read"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_edu_notification_centre_search" model="ir.ui.view">
        <field name="name">edu.notification.centre.search</field>
        <field name="model">edu.notification.centre</field>
        <field name="arch" type="xml">
            <search string="Search Notifications">
                <field name="title"/>
                <field name="user_id"/>
                <filter name="filter_unread" string="Unread"
                    domain="[('is_read', '=', False)]"/>
                <filter name="filter_read" string="Read"
                    domain="[('is_read', '=', True)]"/>
                <filter name="filter_my" string="My Notifications"
                    domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User"
                        context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Date"
                        context="{'group_by': 'notification_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_edu_notification_centre" model="ir.actions.act_window">
        <field name="name">Notification Centre</field>
        <field name="res_model">edu.notification.centre</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_notification_centre_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No notifications for you yet.
            </p>
            <p>
                In-app notifications from the Education system will appear here.
            </p>
        </field>
    </record>

</odoo>
