<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <template id="portal_alumni_notifications_list" name="Alumni Notifications List">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Announcements &amp; Alerts</h3>
                    <a href="/my/alumni" class="btn btn-secondary">Back to Dashboard</a>
                </div>

                <t t-if="not notifications">
                    <div class="alert alert-info">You have no new announcements.</div>
                </t>

                <div class="list-group">
                    <t t-foreach="notifications" t-as="notif">
                        <div class="list-group-item list-group-item-action mb-2 shadow-sm rounded">
                            <div class="d-flex w-100 justify-content-between">
                                <!-- Assuming your notification model has a field called 'name' for the subject -->
                                <h5 class="mb-1 text-primary"><t t-esc="notif.name or 'Notification'"/></h5>
                                <small class="text-muted"><t t-esc="notif.create_date.strftime('%d %b %Y')"/></small>
                            </div>
                            <!-- Assuming your notification model has a field called 'message' -->
                            <p class="mb-1 mt-2"><t t-esc="notif.message"/></p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>
