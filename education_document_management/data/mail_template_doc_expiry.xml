<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         Mail template: document expiry alert (S5-T11)
         Sent by edu.doc.expiry.cron to student / guardian
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="mail_template_doc_expiry" model="mail.template">
        <field name="name">Document Expiry Alert</field>
        <field name="model_id" ref="education_core.model_education_document"/>
        <field name="subject">Document Expiry Alert — {{ object.document_type_id.name }}</field>
        <field name="email_to">{{ ctx.get('partner_id') and env['res.partner'].browse(ctx['partner_id']).email or '' }}</field>
        <field name="email_from">{{ (user.email_formatted or user.login) }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 640px; margin: auto; border: 1px solid #e0e0e0; border-radius: 6px; overflow: hidden;">

    <!-- Header -->
    <div style="background: #f0ad4e; padding: 24px 32px;">
        <h2 style="color: #fff; margin: 0;">Document Expiry Notice</h2>
    </div>

    <!-- Body -->
    <div style="padding: 24px 32px;">
        <p>Dear Parent / Guardian,</p>

        <p>This is an automated reminder that the following document is
        {% if object.expiry_state == 'expired' %}
            <strong style="color:#d9534f;">EXPIRED</strong>.
        {% else %}
            <strong style="color:#f0ad4e;">expiring soon</strong>.
        {% endif %}
        </p>

        <table style="width:100%; border-collapse:collapse; margin: 16px 0;">
            <tr style="background:#f5f5f5;">
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Document</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">{{ object.document_type_id.name }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Reference</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">{{ object.name }}</td>
            </tr>
            <tr style="background:#f5f5f5;">
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Issue Date</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">{{ object.issue_date or '—' }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Expiry Date</td>
                <td style="padding:8px 12px; border:1px solid #ddd; color:#d9534f;">
                    <strong>{{ object.expiry_date }}</strong>
                </td>
            </tr>
        </table>

        <p>Please renew / re-upload the document at the earliest to keep your records up to date.</p>
        <p style="margin-top:24px;">
            Regards,<br/>
            <strong>Admissions &amp; Records Office</strong><br/>
            {{ user.company_id.name }}
        </p>
    </div>

    <!-- Footer -->
    <div style="background:#f9f9f9; padding:12px 32px; border-top:1px solid #e0e0e0; font-size:11px; color:#888;">
        This is an automated alert. Please do not reply to this email.
    </div>

</div>
        ]]></field>
        <field name="lang">{{ object.enrollment_id.student_partner_id.lang or object.application_id.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
