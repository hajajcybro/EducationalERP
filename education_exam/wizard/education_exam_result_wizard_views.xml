<odoo>
    <record id="view_exam_result_class_report_wizard_form" model="ir.ui.view">
        <field name="name">exam.result.class.report.wizard.form</field>
        <field name="model">exam.result.class.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Class-wise Exam Result Report">
                <sheet>
                    <group>
                        <field name="class_id"/>
                        <field name="exam_id"/>
                        <field name="session_id"/>
                    </group>
                    <footer>
                        <button string="Print Report" type="object" name="print_report" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_exam_classwise_wizard" model="ir.actions.act_window">
        <field name="name">Class-wise Exam Report</field>
        <field name="res_model">exam.result.class.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_exam_classwise_report"
              name="Class-wise Exam Report"
              parent="menu_reporting"
              action="action_open_exam_classwise_wizard"
              sequence="15"
              groups="education_core.group_education_teacher,education_core.group_education_admin"
    />
</odoo>
