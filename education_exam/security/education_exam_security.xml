<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="education_exam_student_rule" model="ir.rule">
        <field name="name">Student: View Published Exams Only</field>
        <field name="model_id" ref="model_education_exam"/>
        <field name="domain_force">[('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_student'))]"/>
       <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="education_exam_revaluation_student_rule" model="ir.rule">
        <field name="name">Student: View Ongoing Revaluation Only</field>
        <field name="model_id" ref="model_education_exam_revaluation_creation"/>
        <field name="domain_force">[('state', '=', 'ongoing')]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>




</odoo>
