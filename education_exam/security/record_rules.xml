<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- G-01: Portal users see only their own exam results -->
    <record id="rule_exam_result_portal_own" model="ir.rule">
        <field name="name">Exam Result: portal sees own record only</field>
        <field name="model_id" ref="model_edu_exam_result"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('enrollment_id.student_partner_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- G-03: Re-evaluation wizard — portal users can only request for own results -->
    <record id="rule_reevaluation_wizard_portal_own" model="ir.rule">
        <field name="name">Re-evaluation: portal scoped to own result</field>
        <field name="model_id" ref="model_edu_exam_reevaluation_wizard"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('result_id.enrollment_id.student_partner_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
