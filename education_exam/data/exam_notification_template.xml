<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- =====================================
             Exam Published Email Template
        ====================================== -->
        <record id="email_template_exam_published" model="mail.template">
            <field name="name">Exam: Published Notification</field>
            <field name="model_id" ref="model_education_exam"/>
            <field name="email_from">
                {{ user.email_formatted or user.company_id.email_formatted }}
            </field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="False"/>
            <field name="subject">
                {{ object.program_id.name }} - {{ object.exam_type_id.name }} Exam Notification
            </field>
            <field name="description">
                Exam notification sent to students
            </field>
            <field name="body_html" type="html">
                <div style="margin:0; padding:0;">
                    <p style="font-size:13px; margin:0; padding:0;">
                        Dear Student,
                        <br/><br/>

                        This is to inform you that an examination has been scheduled
                        for your class. Please find the details below:
                        <br/><br/>

                        <strong>Exam Details:</strong>
                        <br/>

                        <t t-if="object.program_id">
                            Program:
                            <strong>
                                <t t-out="object.program_id.name"/>
                            </strong>
                            <br/>
                        </t>

                        <t t-if="object.session_id">
                            Session:
                            <strong>
                                <t t-out="object.session_id.name"/>
                            </strong>
                            <br/>
                        </t>

                        <t t-if="object.exam_type_id">
                            Exam Type:
                            <strong>
                                <t t-out="object.exam_type_id.name"/>
                            </strong>
                            <br/>
                        </t>

                        <t t-if="object.start_date">
                            Start Date:
                            <strong>
                                <t t-out="object.start_date"/>
                            </strong>
                            <br/>
                        </t>

                        <t t-if="object.end_date">
                            End Date:
                            <strong>
                                <t t-out="object.end_date"/>
                            </strong>
                            <br/>
                        </t>

                        <br/>
                        Please log in to the student portal to view the detailed
                        subject-wise exam timetable.
                        <br/><br/>

                        If you have any questions, please contact the administration.
                        <br/><br/>

                        <t t-if="not is_html_empty(user.signature)">
                            <div>
                                --
                                <br/>
                                <t t-out="user.signature"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div>
                                --
                                <br/>
                                <t t-out="user.company_id.name"/>
                            </div>
                        </t>
                    </p>
                </div>
            </field>

            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
