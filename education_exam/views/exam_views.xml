<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         edu.exam — Form, List, Search (S4-T07)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_edu_exam_form" model="ir.ui.view">
        <field name="name">edu.exam.form</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <form string="Examination">
                <header>
                    <button name="action_schedule" type="object"
                            string="Schedule" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" type="object"
                            string="Mark Ongoing" class="btn-warning"
                            invisible="state != 'scheduled'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_publish_results" type="object"
                            string="Publish Results" class="btn-success"
                            invisible="state != 'ongoing'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-secondary"
                            invisible="state != 'result_published'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ['scheduled','ongoing']"
                            groups="education_security.group_education_admin"/>
                    <button name="action_generate_seating" type="object"
                            string="Generate Seating Plan" class="btn-secondary"
                            invisible="state not in ['scheduled','ongoing']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,ongoing,result_published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-book"
                                name="%(action_edu_exam_result)d" type="action"
                                invisible="result_count == 0"
                                context="{'default_exam_id': active_id,
                                          'search_default_exam_id': active_id}">
                            <field name="result_count" widget="statinfo"
                                   string="Results"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-users"
                                invisible="seating_count == 0">
                            <field name="seating_count" widget="statinfo"
                                   string="Seats"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="code" class="text-muted small"/>
                        <h1>
                            <field name="code" readonly="1" class="text-muted me-2"/>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="exam_type"/>
                            <field name="academic_year_id"/>
                            <field name="class_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab 1: Subject Schedule -->
                        <page string="Subject Schedule" name="subjects">
                            <field name="subject_line_ids">
                                <list string="Subjects" editable="bottom">
                                    <field name="subject"/>
                                    <field name="exam_date"/>
                                    <field name="exam_time" widget="float_time"/>
                                    <field name="duration_hours"/>
                                    <field name="max_marks"/>
                                    <field name="pass_marks"/>
                                    <field name="classroom_id"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 2: Seating Plan -->
                        <page string="Seating Plan" name="seating">
                            <field name="seating_ids">
                                <list string="Seating" editable="bottom">
                                    <field name="roll_no"/>
                                    <field name="student_name" readonly="1"/>
                                    <field name="class_id" readonly="1"/>
                                    <field name="classroom_id"/>
                                    <field name="seat_no"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 3: Invigilators -->
                        <page string="Invigilators" name="invigilators">
                            <field name="invigilator_ids">
                                <list string="Invigilators" editable="bottom">
                                    <field name="date"/>
                                    <field name="faculty_id"/>
                                    <field name="classroom_id"/>
                                    <field name="subject"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 4: Results -->
                        <page string="Results" name="results"
                              invisible="state == 'draft'">
                            <field name="result_ids">
                                <list string="Results"
                                      decoration-success="pass_fail == 'pass'"
                                      decoration-danger="pass_fail == 'fail'"
                                      decoration-muted="pass_fail == 'absent'">
                                    <field name="roll_no"/>
                                    <field name="student_name"/>
                                    <field name="class_id"/>
                                    <field name="subject"/>
                                    <field name="marks_obtained"/>
                                    <field name="max_marks"/>
                                    <field name="percentage" widget="percentage"/>
                                    <field name="grade"/>
                                    <field name="pass_fail" widget="badge"
                                           decoration-success="pass_fail == 'pass'"
                                           decoration-danger="pass_fail == 'fail'"
                                           decoration-warning="pass_fail == 'absent'"/>
                                    <field name="rank"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'published'"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 5: Notes -->
                        <page string="Instructions" name="notes">
                            <field name="notes" placeholder="Exam rules, instructions…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────── -->
    <record id="view_edu_exam_list" model="ir.ui.view">
        <field name="name">edu.exam.list</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <list string="Examinations" default_order="date_from desc">
                <field name="code" optional="hide"/>
                <field name="name"/>
                <field name="exam_type" widget="badge"
                       decoration-info="exam_type == 'unit_test'"
                       decoration-warning="exam_type == 'mid_term'"
                       decoration-danger="exam_type == 'final'"/>
                <field name="academic_year_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="subject_count" string="Subjects"/>
                <field name="result_count" string="Results"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'scheduled'"
                       decoration-warning="state == 'ongoing'"
                       decoration-success="state == 'result_published'"
                       decoration-primary="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_edu_exam_search" model="ir.ui.view">
        <field name="name">edu.exam.search</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <search string="Search Exams">
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="class_ids"/>
                <separator/>
                <filter string="Draft"    name="draft"    domain="[('state','=','draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('state','=','scheduled')]"/>
                <filter string="Ongoing"  name="ongoing"  domain="[('state','=','ongoing')]"/>
                <filter string="Results Published" name="published"
                        domain="[('state','=','result_published')]"/>
                <separator/>
                <filter string="Final Exams" name="final"
                        domain="[('exam_type','=','final')]"/>
                <filter string="Mid-Terms"   name="midterm"
                        domain="[('exam_type','=','mid_term')]"/>
                <group expand="0" string="Group By">
                    <filter string="Exam Type"    name="group_type"
                            context="{'group_by': 'exam_type'}"/>
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Status"       name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────── -->
    <record id="action_edu_exam" model="ir.actions.act_window">
        <field name="name">Examinations</field>
        <field name="res_model">edu.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No exams scheduled yet</p>
            <p>Create an exam, add subject schedule and generate seating plans.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.exam.result — Standalone result views
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_exam_result_form" model="ir.ui.view">
        <field name="name">edu.exam.result.form</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <form string="Exam Result">
                <header>
                    <button name="%(edu_exam_reevaluation_wizard_action)d"
                            type="action" string="Request Re-evaluation"
                            invisible="state != 'published'"
                            context="{'default_result_id': active_id}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="exam_id"/>
                            <field name="enrollment_id"/>
                            <field name="student_name" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="roll_no" readonly="1"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="marks_obtained"/>
                            <field name="max_marks"/>
                            <field name="pass_marks"/>
                            <field name="absent"/>
                        </group>
                    </group>
                    <group string="Computed Results" readonly="1">
                        <group>
                            <field name="percentage"/>
                            <field name="grade"/>
                        </group>
                        <group>
                            <field name="pass_fail" widget="badge"
                                   decoration-success="pass_fail == 'pass'"
                                   decoration-danger="pass_fail == 'fail'"/>
                            <field name="rank"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Change History" name="history">
                            <field name="history_ids">
                                <list string="History" create="false" delete="false">
                                    <field name="change_date"/>
                                    <field name="old_marks"/>
                                    <field name="new_marks"/>
                                    <field name="delta"/>
                                    <field name="changed_by_id"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_exam_result_list" model="ir.ui.view">
        <field name="name">edu.exam.result.list</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <list string="Exam Results"
                  decoration-success="pass_fail == 'pass'"
                  decoration-danger="pass_fail == 'fail'"
                  decoration-muted="pass_fail == 'absent'">
                <field name="exam_id" optional="hide"/>
                <field name="roll_no"/>
                <field name="student_name"/>
                <field name="class_id"/>
                <field name="subject"/>
                <field name="marks_obtained"/>
                <field name="max_marks"/>
                <field name="percentage" widget="percentage"/>
                <field name="grade"/>
                <field name="pass_fail" widget="badge"
                       decoration-success="pass_fail == 'pass'"
                       decoration-danger="pass_fail == 'fail'"
                       decoration-warning="pass_fail == 'absent'"/>
                <field name="rank"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_exam_result_search" model="ir.ui.view">
        <field name="name">edu.exam.result.search</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <search string="Search Results">
                <field name="student_name"/>
                <field name="subject"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <separator/>
                <filter string="Pass"   name="pass"   domain="[('pass_fail','=','pass')]"/>
                <filter string="Fail"   name="fail"   domain="[('pass_fail','=','fail')]"/>
                <filter string="Absent" name="absent" domain="[('pass_fail','=','absent')]"/>
                <separator/>
                <filter string="Published" name="published"
                        domain="[('state','=','published')]"/>
                <group expand="0" string="Group By">
                    <filter string="Exam"    name="group_exam"
                            context="{'group_by': 'exam_id'}"/>
                    <filter string="Class"   name="group_class"
                            context="{'group_by': 'class_id'}"/>
                    <filter string="Subject" name="group_subject"
                            context="{'group_by': 'subject'}"/>
                    <filter string="Grade"   name="group_grade"
                            context="{'group_by': 'grade'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_exam_result" model="ir.actions.act_window">
        <field name="name">Exam Results</field>
        <field name="res_model">edu.exam.result</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_result_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No results yet</p>
            <p>Use the Mark Entry wizard to bulk-enter student marks.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Mark Entry Wizard — S4-T09
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mark_entry_wizard_form" model="ir.ui.view">
        <field name="name">edu.exam.mark.entry.wizard.form</field>
        <field name="model">edu.exam.mark.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Entry">
                <sheet>
                    <group string="Exam Details">
                        <group>
                            <field name="exam_id"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="class_id"/>
                            <field name="max_marks"/>
                            <field name="pass_marks"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list string="Student Marks" editable="bottom">
                            <field name="student_name" readonly="1"/>
                            <field name="absent"/>
                            <field name="marks_obtained"
                                   readonly="absent"
                                   decoration-danger="marks_obtained == 0 and not absent"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_marks" type="object"
                            string="Save Marks" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mark_entry_wizard" model="ir.actions.act_window">
        <field name="name">Enter Marks</field>
        <field name="res_model">edu.exam.mark.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Re-evaluation Wizard — S4-T06
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_reevaluation_wizard_form" model="ir.ui.view">
        <field name="name">edu.exam.reevaluation.wizard.form</field>
        <field name="model">edu.exam.reevaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Re-evaluation">
                <sheet>
                    <group>
                        <field name="result_id" readonly="1"/>
                        <field name="student_name" readonly="1"/>
                        <field name="subject" readonly="1"/>
                        <field name="current_marks" readonly="1"/>
                    </group>
                    <group string="Request Details">
                        <field name="reason" nolabel="1"
                               placeholder="Explain why re-evaluation is needed…"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" type="object"
                            string="Submit Request" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="edu_exam_reevaluation_wizard_action" model="ir.actions.act_window">
        <field name="name">Request Re-evaluation</field>
        <field name="res_model">edu.exam.reevaluation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
