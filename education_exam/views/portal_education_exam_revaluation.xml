<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_revaluation_form">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2>Revaluation Application</h2>

                <t t-if="error_message">
                    <div class="alert alert-danger">
                        <t t-esc="error_message"/>
                    </div>
                </t>

                <t t-if="request.params.get('success')">
                    <div class="alert alert-success">
                        Application submitted successfully.
                    </div>
                </t>

                <form action="/my/revaluation/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label>Exam</label>
                        <select name="exam_id" class="form-control">
                            <t t-foreach="exams" t-as="exam">
                                <option t-att-value="exam.id">
                                    <t t-esc="exam.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Subject</label>
                        <select name="course_id" class="form-control">
                            <t t-foreach="exams" t-as="exam">
                                <t t-foreach="exam.course_line_ids" t-as="line">
                                    <option t-att-value="line.course_id.id">
                                        <t t-esc="line.course_id.name"/>
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Submit Application
                    </button>
                </form>
            </div>
        </t>
    </template>
</odoo>