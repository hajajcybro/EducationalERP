<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Form view of Education Revaluation Creation-->
    <record id='education_exam_revaluation_creation_view_form' model='ir.ui.view'>
        <field name="name">education.exam.revaluation.creation.view.form</field>
        <field name="model">education.exam.revaluation.creation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight" string="Confirm"/>
                    <button name="action_apply" type="object"
                             invisible="state != 'ongoing'"
                            class="oe_highlight" string="Apply"/>
                    <button name="action_close" type="object" class="oe_highlight"
                            invisible="state not in ('draft', 'ongoing')"
                            string="Closed"/>
                    <field name="state" readonly="1" widget="statusbar"
                           statusbar_visible="draft,ongoing,closed"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="exam_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

         <!-- Tree view for Revaluation -->
    <record id="education_exam_revaluation_creation_view_tree1" model="ir.ui.view">
        <field name="name">education.exam.revaluation.creation.view.list</field>
        <field name="model">education.exam.revaluation.creation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exam_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <!--  Action for Revaluation   -->
    <record id="action_edu_exam_revaluation_creation" model="ir.actions.act_window">
        <field name="name">Exam ReValuation Creation</field>
        <field name="res_model">education.exam.revaluation.creation</field>
        <field name="view_mode">list,form</field>
    </record>


    <!--  Menu Items for Revaluation   -->
    <menuitem id="menu_education_revaluation_creation"
              name="Revaluation"
              parent="menu_exam_configuration"
              action="action_edu_exam_revaluation_creation"
              sequence="50"/>

</odoo>
