<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--   Form view for education exam   -->
    <record id="education_exam_revaluation_view_form" model="ir.ui.view">
        <field name="name">education.exam.revaluation.view.form</field>
        <field name="model">education.exam.revaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight" string="Confirm"/>
                    <button name="action_cancel" type="object"
                            invisible="state != 'draft'"
                            string="Cancel"/>
                    <field name="state" readonly="1" widget="statusbar"
                           statusbar_visible="draft,confirm,cancel"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="exam_id" readonly="state != 'draft'"/>
                            <field name="program_id" readonly="state != 'draft'"/>
<!--                            <field name="session_id" readonly="state != 'draft'"/>-->
                            <field name="class_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="course_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>

                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>



    <!--   Tree view for education exam   -->
    <record id="education_exam_revaluation_view_tree" model="ir.ui.view">
        <field name="name">education.exam.revaluation.view.list</field>
        <field name="model">education.exam.revaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="class_id"/>
<!--                                <field name="session_id"/>-->
                <field name="course_id"/>
                <field name="date"/>

            </list>
        </field>
    </record>

    <record id="action_edu_exam_revaluation" model="ir.actions.act_window">
        <field name="name">Exam ReValuation</field>
        <field name="res_model">education.exam.revaluation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--  Menu Items for education exam   -->

    <menuitem id="menu_exam_revaluation"
              name="ReValuation Application"
              parent="menu_examination"
              action="action_edu_exam_revaluation"
              sequence="30"
    />

</odoo>
