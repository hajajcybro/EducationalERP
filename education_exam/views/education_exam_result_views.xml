<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--   Form view for the Education exam results   -->
    <record id="education_exam_result_view_form" model="ir.ui.view">
        <field name="name">education.exam.result.view.form</field>
        <field name="model">education.exam.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="exam_id"/>
                            <field name="program_id"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="class_id"/>
<!--                            <field name="division_id"/>-->
                            <field name="academic_year_id"/>
                            <field name="valuation_completed"  invisible="1"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Mark Sheet">
                            <field name="result_line_ids" widget="one2many" mode="list" >
                                <list>
                                    <field name="course_id"/>
                                    <field name="max_mark" sum="Total"/>
                                    <field name="pass_mark" sum="Total"/>
                                    <field name="mark_scored" sum="Total"/>
                                    <field name="new_mark" sum="Total" optional="hide"/>
                                    <field name="grade_id" optional="hide"/>
                                    <field name="pass_or_fail"
                                           widget="boolean_toggle"
                                           readonly="1"/>
                                    <field name="result_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                 <field name="total_max_mark"
                                       sum="Total Mark"/>
                                <field name="total_mark_scored"
                                       sum="Scored Total"/>
                                <field name="all_pass"
                                       widget="boolean_toggle"/>
                                 <field name="overall_grade" readonly="1"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--   Tree view for the Education exam results   -->
    <record id="education_exam_result_view_list" model="ir.ui.view">
        <field name="name">education.exam.result.view.list</field>
        <field name="model">education.exam.result</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="exam_id"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="session_id"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <field name="total_mark_scored"/>
                <field name="all_pass" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
