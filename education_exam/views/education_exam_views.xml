<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--   Form view for education exam   -->
    <record id="education_exam_view_form" model="ir.ui.view">
        <field name="name">education.exam.view.form</field>
        <field name="model">education.exam</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight" string="Confirm"/>
                    <button name="action_cancel" type="object"
                            invisible="state != 'draft'"
                            string="Cancel"/>
                    <button name="action_draft"
                            type="object" string="Reset to Draft" invisible="state != 'closed'" data-hotkey="w"/>
                    <field name="state" readonly="1" widget="statusbar"
                           statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="exam_type_id" readonly="state != 'draft'"/>
                            <field name="program_id" readonly="state != 'draft'"/>
                            <field name="session_id" readonly="state != 'draft'"/>
                            <field name="class_id" readonly="state != 'draft'"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="start_date"
                                   readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="valuation_completed"  invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Courses">
                            <field name="course_line_ids" context="{'list_view_ref': 'education_exam_line_view_tree'}"/>

                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--   List view for education exam   -->
    <record id="education_exam_view_tree" model="ir.ui.view">
        <field name="name">education.exam.view.list</field>
        <field name="model">education.exam</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exam_type_id"/>
                <field name="program_id"/>
                <field name="session_id"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--   Tree view for education exam line   -->

    <record id="education_exam_line_view_tree" model="ir.ui.view">
        <field name="name">education.exam.line.view.tree</field>
        <field name="model">education.exam.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="course_id"/>
                <field name="date"/>
                <field name="time_from" widget="float_time"/>
                <field name="time_to" widget="float_time"/>
                <field name="max_marks"/>
                <field name="weightage"/>
                <field name="exam_id" column_invisible="True"/>


            </list>
        </field>
    </record>

    <!--  Action for education exam   -->
    <record id="action_edu_exam" model="ir.actions.act_window">
        <field name="name">Examination</field>
        <field name="res_model">education.exam</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--  Menu Items for education exam   -->

    <menuitem id="menu_examination_root"
              name="Examination"
              sequence="10"/>
    <menuitem id="menu_examination"
              name="Examination"
              parent="menu_examination_root"
              sequence="10"/>

    <menuitem id="menu_examination_exam"
              name="Examination"
              parent="menu_examination"
              action="action_edu_exam"/>

</odoo>
