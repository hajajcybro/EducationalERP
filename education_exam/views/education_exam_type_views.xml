<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Tree view of Education Exam Type-->
    <record id='education_exam_type_view_tree' model='ir.ui.view'>
        <field name="name">education.exam.type.view.list</field>
        <field name="model">education.exam.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <!--Menu Action of Education Exam Type-->
    <record id="action_eduction_exam_type"
            model="ir.actions.act_window">
        <field name="name">Education Exam Type</field>
        <field name="res_model">education.exam.type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your first Education type here.
            </p>
        </field>
    </record>
  <menuitem id="menu_exam_configuration"
              name="Configuration"
              parent="menu_examination_root"
              sequence="30"/>
    <menuitem id="menu_education_exam_type"
              name="Exam Type"
              parent="menu_exam_configuration"
              action="action_eduction_exam_type"
              sequence="20"
              groups="education_core.group_education_teacher,education_core.group_education_admin"
    />

</odoo>
