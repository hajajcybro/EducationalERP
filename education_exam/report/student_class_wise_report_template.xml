<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_classwise_exam_result_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="wizard">
                    <div class="page">
                        <h2>Class:
                            <t t-esc="wizard.class_id.name"/>
                        </h2>
                        <h3>Exam:
                            <t t-esc="wizard.exam_id.name"/>
                        </h3>
                        <t t-set="results" t-value="env['education.exam.result'].search([
                        ('class_id','=',wizard.class_id.id),
                        ('exam_id','=',wizard.exam_id.id),
                        ('session_id','=',wizard.session_id.id if wizard.session_id else False)
                    ])"/>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Total Marks</th>
                                    <th>Overall Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="results" t-as="res">
                                    <tr>
                                        <td>
                                            <t t-esc="res.student_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="res.total_mark_scored"/>
                                        </td>
                                        <td>
                                            <t t-if="res.all_pass">Pass</t>
                                            <t t-else="">Fail</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
