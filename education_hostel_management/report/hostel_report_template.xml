<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_hostel_dynamic">
    <t t-call="web.external_layout">
        <main>
            <div class="page">
                <h2 class="text-center">Hostel Report</h2>

                <!-- OCCUPANCY -->
                <t t-if="data.get('report_type') == 'occupancy'">
                    <h4>Occupancy per Hostel</h4>

                    <table class="table table-bordered">
                        <tr>
                            <th>Hostel</th>
                            <th>Capacity</th>
                            <th>Allocated</th>
                            <th>Vacancy</th>
                        </tr>

                        <t t-foreach="docs" t-as="rec">
                            <tr>
                                <td><t t-esc="rec.name"/></td>
                                <td><t t-esc="rec.capacity"/></td>
                                <td><t t-esc="rec.total_students"/></td>
                                <td><t t-esc="rec.vacancy"/></td>
                            </tr>
                        </t>
                    </table>
                </t>

                <!-- STUDENT -->
                <t t-if="data.get('report_type') == 'student'">
                    <h4>Student Room Assignment</h4>

                    <table class="table table-bordered">
                        <tr>
                            <th>Student</th>
                            <th>Room</th>
                            <th>Hostel</th>
                            <th>Allocated</th>
                            <th>Vacated</th>
                        </tr>

                        <t t-foreach="docs" t-as="rec">
                            <tr>
                                <td><t t-esc="rec.hostel_application_id.student_id.name"/></td>
                                <td><t t-esc="rec.room_id.room_no"/></td>
                                <td><t t-esc="rec.hostel_id.name"/></td>
                                <td><t t-esc="rec.allocated_date"/></td>
                                <td><t t-esc="rec.vacated_date or '-'"/></td>
                            </tr>
                        </t>
                    </table>
                </t>

                <!-- VACANT -->
                <t t-if="data.get('report_type') == 'vacant'">
                    <h4>Vacant Rooms</h4>

                    <table class="table table-bordered">
                        <tr>
                            <th>Room</th>
                            <th>Hostel</th>
                            <th>Vacancy</th>
                        </tr>

                        <t t-foreach="docs" t-as="rec">
                            <tr>
                                <td><t t-esc="rec.room_no"/></td>
                                <td><t t-esc="rec.hostel_id.name"/></td>
                                <td><t t-esc="rec.vacancy"/></td>
                            </tr>
                        </t>
                    </table>
                </t>

            </div>
        </main>
    </t>
</template>
</odoo>