<odoo>
    <record id="view_hostel_report_wizard" model="ir.ui.view">
        <field name="name">hostel.report.wizard.form</field>
        <field name="model">hostel.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Report">
                <group>
                    <field name="report_type" required="1"/>
                    <field name="hostel_id"/>
                    <field name="student_id"
                           invisible="report_type != 'student'"/>
                </group>

                <footer>
                    <button string="Print"
                            type="object"
                            name="action_print_report"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>