<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         education.application — Views (S2-T09, S2-T10)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_education_application_form" model="ir.ui.view">
        <field name="name">education.application.form</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <form string="Student Application">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit Application"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="btn-success"
                            groups="education_security.group_education_admin,
                                    education_security.group_education_admission_officer"
                            invisible="state != 'submitted'"
                            confirm="Approve this application and create enrollment?"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            class="btn-danger"
                            groups="education_security.group_education_admin,
                                    education_security.group_education_admission_officer"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollment" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap"
                                invisible="not enrollment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Enrollment</span>
                            </div>
                        </button>
                        <button name="%(action_education_document_application)d"
                                type="action"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="document_count == 0">
                            <field name="document_count" widget="statinfo"
                                   string="Documents"/>
                        </button>
                    </div>
                    <!-- Photo + header -->
                    <div class="row mb-4">
                        <div class="col-auto">
                            <field name="photo" widget="image"
                                   class="oe_avatar"
                                   options="{'preview_image': 'photo', 'size': [96, 96]}"/>
                        </div>
                        <div class="col">
                            <div class="oe_title">
                                <label for="first_name"/>
                                <h1>
                                    <field name="first_name"
                                           placeholder="First Name"
                                           class="me-2"/>
                                    <field name="last_name"
                                           placeholder="Last Name"/>
                                </h1>
                                <h4>
                                    <field name="admission_no" readonly="1"/>
                                </h4>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- Personal Info Tab -->
                        <page string="Personal Information" name="personal">
                            <group name="personal_main">
                                <group name="personal_left">
                                    <field name="date_of_birth"/>
                                    <field name="age" readonly="1"/>
                                    <field name="gender"/>
                                    <field name="blood_group"/>
                                    <field name="nationality_id"/>
                                </group>
                                <group name="personal_right">
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                </group>
                            </group>
                            <group name="address" string="Address">
                                <field name="address" nolabel="1" placeholder="Street address…"/>
                                <group>
                                    <field name="city"/>
                                    <field name="zip_code"/>
                                </group>
                                <group>
                                    <field name="country_id"/>
                                    <field name="state_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Academic Tab -->
                        <page string="Academic" name="academic">
                            <group>
                                <group>
                                    <field name="program_id"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="academic_year_id"/>
                                </group>
                                <group string="Previous Education">
                                    <field name="last_school"/>
                                    <field name="last_qualification"/>
                                    <field name="last_percentage"/>
                                </group>
                            </group>
                        </page>

                        <!-- Guardian Tab -->
                        <page string="Guardian / Parent" name="guardian">
                            <group>
                                <group>
                                    <field name="guardian_name"/>
                                    <field name="guardian_relation"/>
                                    <field name="guardian_occupation"/>
                                </group>
                                <group>
                                    <field name="guardian_phone"/>
                                    <field name="guardian_email"/>
                                </group>
                            </group>
                        </page>

                        <!-- Documents Tab -->
                        <page string="Documents" name="documents">
                            <field name="document_ids" mode="list" nolabel="1">
                                <list string="Documents" editable="bottom">
                                    <field name="document_type_id"/>
                                    <field name="is_mandatory" readonly="1"/>
                                    <field name="file_name"/>
                                    <field name="file" filename="file_name"/>
                                    <field name="expiry_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'verified'"
                                           decoration-warning="state == 'uploaded'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state == 'pending'"/>
                                    <button name="action_verify" type="object"
                                            string="Verify" icon="fa-check"
                                            invisible="state != 'uploaded'"
                                            groups="education_security.group_education_admin,
                                                    education_security.group_education_admission_officer"/>
                                </list>
                            </field>
                        </page>

                        <!-- Rejection Tab (visible when rejected) -->
                        <page string="Rejection Details" name="rejection"
                              invisible="state != 'rejected'">
                            <group>
                                <field name="rejection_reason" readonly="1"/>
                                <field name="rejected_by_id" readonly="1"/>
                                <field name="rejection_date" readonly="1"/>
                            </group>
                        </page>

                        <!-- Notes Tab -->
                        <page string="Internal Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes (not visible to applicant)…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────── -->
    <record id="view_education_application_list" model="ir.ui.view">
        <field name="name">education.application.list</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <list string="Student Applications"
                  default_order="date_application desc">
                <field name="admission_no"/>
                <field name="name" string="Applicant"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <field name="date_application"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'draft'"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ────────────────────────────────────────────────── -->
    <record id="view_education_application_kanban" model="ir.ui.view">
        <field name="name">education.application.kanban</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="name"/>
                <field name="admission_no"/>
                <field name="program_id"/>
                <field name="email"/>
                <field name="date_application"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="admission_no"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="program_id"/></div>
                                <div class="text-muted small">
                                    <field name="date_application"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_education_application_search" model="ir.ui.view">
        <field name="name">education.application.search</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <search string="Search Applications">
                <field name="admission_no"/>
                <field name="name" string="Applicant Name"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Current Year" name="current_year"
                        domain="[('academic_year_id.is_current', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────── -->
    <record id="action_education_application" model="ir.actions.act_window">
        <field name="name">Student Applications</field>
        <field name="res_model">education.application</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_education_application_search"/>
        <field name="context">{"search_default_current_year": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No applications yet
            </p>
            <p>
                Create a new application to begin the admission process.
            </p>
        </field>
    </record>

    <!-- Action filtered to Documents for an application (smart button) -->
    <record id="action_education_document_application" model="ir.actions.act_window">
        <field name="name">Application Documents</field>
        <field name="res_model">education.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('application_id', '=', active_id)]</field>
        <field name="context">{'default_application_id': active_id}</field>
    </record>

    <!-- ── Rejection Wizard View ─────────────────────────────────────── -->
    <record id="view_application_reject_wizard_form" model="ir.ui.view">
        <field name="name">education.application.reject.wizard.form</field>
        <field name="model">education.application.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Application">
                <sheet>
                    <group>
                        <field name="applicant_name" readonly="1"/>
                        <field name="program_name" readonly="1"/>
                        <field name="application_id" invisible="1"/>
                    </group>
                    <group string="Rejection">
                        <field name="rejection_reason" nolabel="1"
                               placeholder="Provide a clear reason for rejection (min 10 characters)…"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Confirm Rejection"
                            class="btn-danger"/>
                    <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
