<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Subjects tab on Program form ─────────────────────────────────── -->
    <record id="view_education_program_form_subjects" model="ir.ui.view">
        <field name="name">education.program.form.subjects</field>
        <field name="model">education.program</field>
        <field name="inherit_id" ref="view_education_program_form"/>
        <field name="arch" type="xml">
            <!-- stat button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subjects" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="subject_count == 0">
                    <field name="subject_count" widget="statinfo" string="Subjects"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ── Standalone subject list/form ─────────────────────────────────── -->
    <record id="view_education_subject_list" model="ir.ui.view">
        <field name="name">education.subject.list</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="program_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_education_subject_search" model="ir.ui.view">
        <field name="name">education.subject.search</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <group>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">education.subject</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_education_subject_search"/>
        <field name="context">{"search_default_group_program": 1}</field>
    </record>

</odoo>
