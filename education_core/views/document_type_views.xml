<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         education.document.type — Configuration Views (S2-T05, S2-T13)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_education_document_type_form" model="ir.ui.view">
        <field name="name">education.document.type.form</field>
        <field name="model">education.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_mandatory" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Instructions">
                        <field name="description" nolabel="1"
                               placeholder="Instructions shown to the applicant…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────── -->
    <record id="view_education_document_type_list" model="ir.ui.view">
        <field name="name">education.document.type.list</field>
        <field name="model">education.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_mandatory"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────── -->
    <record id="action_education_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">education.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define document types required during admission
            </p>
            <p>
                Examples: Birth Certificate, Mark Sheet, Transfer Certificate.
                Mark as mandatory to enforce upload before approval.
            </p>
        </field>
    </record>

</odoo>
