<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. ALUMNI DASHBOARD -->
    <template id="portal_alumni_dashboard" name="Alumni Dashboard">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2 class="mb-4">Welcome back, <t t-esc="alumni.name"/>!</h2>
                <div class="row" id="alumni_dashboard_cards">
                    <!-- Profile Card -->
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="fa fa-user-circle fa-4x text-primary mb-3"></i>
                                <h4 class="card-title">My Profile</h4>
                                <p class="card-text text-muted">View and update your alumni details.</p>
                                <a href="/my/alumni/profile" class="btn btn-outline-primary">View Profile</a>
                            </div>
                        </div>
                    </div>

                    <!-- Job Board Card -->
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="fa fa-briefcase fa-4x text-success mb-3"></i>
                                <h4 class="card-title">Job Board</h4>
                                <p class="card-text text-muted">
                                    <strong t-esc="job_count"/> active job postings.
                                </p>
                                <a href="/my/alumni/jobs" class="btn btn-outline-success">Browse Jobs</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 2. ALUMNI PROFILE -->
    <template id="portal_alumni_profile" name="Alumni Profile">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>My Alumni Profile</h3>
                    <a href="/my/alumni" class="btn btn-secondary">Back to Dashboard</a>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <img t-if="alumni.image_1920" t-att-src="image_data_uri(alumni.image_1920)" class="img-fluid rounded-circle mb-3" style="max-width: 200px;"/>
                                <i t-if="not alumni.image_1920" class="fa fa-user fa-5x text-muted mb-3"></i>
                                <h4><t t-esc="alumni.name"/></h4>
                                <span class="badge bg-success"><t t-esc="alumni.alumni_status"/></span>
                            </div>
                            <div class="col-md-8">
                                <table class="table table-borderless">
                                    <tbody>
                                        <tr><th>Alumni ID:</th><td><t t-esc="alumni.alumni_reference"/></td></tr>
                                        <tr><th>Graduation Year:</th><td><t t-esc="alumni.graduation_year"/></td></tr>
                                        <tr><th>Program:</th><td><t t-esc="alumni.program_id.name"/></td></tr>
                                        <tr><th>Email:</th><td><t t-esc="alumni.email"/></td></tr>
                                        <tr><th>Phone:</th><td><t t-esc="alumni.phone"/></td></tr>
                                        <tr><th>Occupation:</th><td><t t-esc="alumni.occupation or 'Not Provided'"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 3. ALUMNI NOTIFICATIONS -->
    <template id="portal_alumni_notifications" name="Alumni Notifications">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Announcements &amp; Alerts</h3>
                    <a href="/my/alumni" class="btn btn-secondary">Back to Dashboard</a>
                </div>

                <t t-if="not notifications">
                    <div class="alert alert-info">No new announcements at this time.</div>
                </t>

                <div class="list-group">
                    <t t-foreach="notifications" t-as="notif">
                        <div class="list-group-item list-group-item-action mb-2 shadow-sm rounded">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1 text-primary"><t t-esc="notif.title or 'Notification'"/></h5>
                                <small class="text-muted"><t t-esc="notif.create_date.strftime('%d %b %Y')"/></small>
                            </div>
                            <p class="mb-1 mt-2"><t t-esc="notif.message"/></p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- 4. ALUMNI JOB BOARD -->
    <template id="portal_alumni_jobs" name="Alumni Jobs">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Alumni Job Board</h3>
                    <div>
                        <a href="/my/alumni/jobs/new" class="btn btn-success"><i class="fa fa-plus"></i> Post a Job</a>
                        <a href="/my/alumni" class="btn btn-secondary">Back</a>
                    </div>
                </div>

                <t t-if="not jobs">
                    <div class="alert alert-info">No job vacancies posted yet. Be the first to post!</div>
                </t>

                <div class="row">
                    <t t-foreach="jobs" t-as="job">
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-success">
                                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><t t-esc="job.job_title"/></h5>
                                    <small><t t-esc="job.create_date.strftime('%d %b %Y')"/></small>
                                </div>
                                <div class="card-body">
                                    <h6 class="text-muted"><i class="fa fa-building"></i> <t t-esc="job.company_name"/></h6>
                                    <hr/>
                                    <p class="card-text" style="white-space: pre-wrap;"><t t-esc="job.description"/></p>
                                </div>
                                <div class="card-footer text-muted text-end">
                                    <small>Posted by: <t t-esc="job.posted_by_id.name"/></small>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- 5. ALUMNI POST A JOB FORM -->
    <template id="portal_alumni_job_submit" name="Submit a Job">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Post a Job Vacancy</h4>
                    </div>
                    <div class="card-body">
                        <form action="/my/alumni/jobs/new" method="post" enctype="multipart/form-data">
                            <!-- Odoo CSRF token is mandatory for custom portal forms! -->
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="mb-3">
                                <label for="job_title" class="form-label fw-bold">Job Title</label>
                                <input type="text" class="form-control" id="job_title" name="job_title" required="required" placeholder="e.g. Senior Software Engineer"/>
                            </div>

                            <div class="mb-3">
                                <label for="company_name" class="form-label fw-bold">Company Name</label>
                                <input type="text" class="form-control" id="company_name" name="company_name" required="required" placeholder="Where is the job located?"/>
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label fw-bold">Job Description &amp; How to Apply</label>
                                <textarea class="form-control" id="description" name="description" rows="5" required="required" placeholder="Describe the role, requirements, and provide a link or email for applicants to send their CV."></textarea>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <a href="/my/alumni/jobs" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-primary">Publish Job</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>