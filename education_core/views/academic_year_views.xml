<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         education.academic.year — Views
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Form -->
    <record id="view_academic_year_form" model="ir.ui.view">
        <field name="name">education.academic.year.form</field>
        <field name="model">education.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <header>
                    <button name="action_set_current" type="object"
                            string="Set as Current Year"
                            class="btn-primary"
                            invisible="is_current == True"
                            confirm="This will unset the current active year. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users"
                                invisible="enrollment_count == 0">
                            <field name="enrollment_count" widget="statinfo"
                                   string="Enrollments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. 2025-2026"/>
                        </h1>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="code"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group name="right">
                            <field name="is_current" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_academic_year_list" model="ir.ui.view">
        <field name="name">education.academic.year.list</field>
        <field name="model">education.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Years" default_order="date_start desc">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean"
                       decoration-success="is_current == True"/>
                <field name="enrollment_count" string="Enrollments"
                       optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_academic_year_search" model="ir.ui.view">
        <field name="name">education.academic.year.search</field>
        <field name="model">education.academic.year</field>
        <field name="arch" type="xml">
            <search string="Search Academic Years">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Current Year" name="current" domain="[('is_current', '=', True)]"/>
                 <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">education.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_academic_year_search"/>
        <field name="context">{"search_default_active": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first academic year
            </p>
            <p>
                Academic years define the time frame for enrollments,
                examinations and fee cycles.
            </p>
        </field>
    </record>

</odoo>
