<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Window Action ─────────────────────────────────────────────── -->
    <record id="action_education_faculty" model="ir.actions.act_window">
        <field name="name">Faculty</field>
        <field name="res_model">education.faculty</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first faculty member</p>
            <p>Create faculty profiles, assign departments and track qualifications and teaching workload.</p>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────── -->
    <record id="view_education_faculty_form" model="ir.ui.view">
        <field name="name">education.faculty.form</field>
        <field name="model">education.faculty</field>
        <field name="arch" type="xml">
            <form string="Faculty Member">
                <header>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <div class="ov_button_box" name="button_box">
                        <button name="action_view_timetable_slots"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <div class="o_stat_info">
                                <field name="weekly_periods" widget="statinfo"
                                       string="Weekly Periods"/>
                            </div>
                        </button>
                        <button name="action_view_timetable_slots"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle"
                                invisible="not is_overloaded">
                            <div class="o_stat_info o_field_widget">
                                <span class="o_stat_text text-danger">Overloaded</span>
                            </div>
                        </button>
                    </div>

                    <field name="photo" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'photo', 'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Faculty Name"/></h1>
                        <div class="o_row">
                            <field name="faculty_id" readonly="1"/>
                            <span class="mx-1">·</span>
                            <field name="designation" placeholder="Designation"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Personal Info" name="personal">
                            <group>
                                <group string="Identity">
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                    <field name="blood_group"/>
                                    <field name="nationality_id"/>
                                </group>
                                <group string="Contact">
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="address"/>
                                </group>
                            </group>
                        </page>

                        <page string="Academic Profile" name="academic">
                            <group>
                                <group>
                                    <field name="department_id"/>
                                    <field name="specialization"/>
                                    <field name="employment_type"/>
                                    <field name="date_joined"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                                <group>
                                    <field name="highest_qualification" readonly="1"/>
                                    <field name="employee_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Qualifications" name="qualifications">
                            <field name="qualification_ids">
                                <list editable="bottom">
                                    <field name="degree"/>
                                    <field name="field_of_study"/>
                                    <field name="institution"/>
                                    <field name="year_obtained"/>
                                    <field name="grade"/>
                                    <field name="certificate_file" widget="binary"
                                           filename="certificate_file_name"/>
                                    <field name="certificate_file_name" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────── -->
    <record id="view_education_faculty_list" model="ir.ui.view">
        <field name="name">education.faculty.list</field>
        <field name="model">education.faculty</field>
        <field name="arch" type="xml">
            <list string="Faculty"
                  decoration-danger="is_overloaded"
                  decoration-muted="not active">
                <field name="faculty_id"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="designation"/>
                <field name="employment_type"/>
                <field name="specialization"/>
                <field name="highest_qualification"/>
                <field name="email"/>
                <field name="weekly_periods"/>
                <field name="is_overloaded" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ───────────────────────────────────────────────── -->
    <record id="view_education_faculty_kanban" model="ir.ui.view">
        <field name="name">education.faculty.kanban</field>
        <field name="model">education.faculty</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="faculty_id"/>
                <field name="department_id"/>
                <field name="designation"/>
                <field name="photo"/>
                <field name="weekly_periods"/>
                <field name="is_overloaded"/>
                <field name="email"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <field name="photo" widget="image"
                                   options="{'size': [48, 48]}"
                                   class="rounded-circle"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted small">
                                    <field name="designation"/>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">
                                <field name="department_id"/>
                            </span>
                            <span t-attf-class="badge #{record.is_overloaded.raw_value ? 'bg-danger' : 'bg-success'}">
                                <field name="weekly_periods"/> periods/wk
                            </span>
                        </div>
                        <div class="text-muted small mt-1">
                            <i class="fa fa-envelope me-1"/>
                            <field name="email"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────── -->
    <record id="view_education_faculty_search" model="ir.ui.view">
        <field name="name">education.faculty.search</field>
        <field name="model">education.faculty</field>
        <field name="arch" type="xml">
            <search string="Search Faculty">
                <field name="name" string="Faculty"
                       filter_domain="['|', ('name', 'ilike', self), ('faculty_id', 'ilike', self)]"/>
                <field name="department_id"/>
                <field name="specialization"/>
                <field name="designation"/>
                <filter string="Permanent" name="permanent"
                        domain="[('employment_type', '=', 'permanent')]"/>
                <filter string="Visiting / Adjunct" name="visiting"
                        domain="[('employment_type', '=', 'visiting')]"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Employment Type" name="group_employment"
                            context="{'group_by': 'employment_type'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
