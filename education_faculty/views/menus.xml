<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        education_faculty — Menu structure
        Adds a "Faculty" submenu under the root Education app menu.
    -->

    <!-- ── Faculty root submenu ───────────────────────────────────── -->
    <menuitem
        id="menu_education_faculty_root"
        name="Faculty"
        parent="education_config.menu_education_root"
        sequence="15"
        groups="education_security.group_education_admin,
                education_security.group_education_teacher"/>

    <!-- Faculty List -->
    <menuitem
        id="menu_education_faculty"
        name="Faculty Members"
        parent="menu_education_faculty_root"
        action="action_education_faculty"
        sequence="10"
        groups="education_security.group_education_admin,
                education_security.group_education_teacher"/>

    <!-- ── Configuration: Faculty (under education_core config) ─── -->
    <menuitem
        id="menu_faculty_config"
        name="Faculty"
        parent="education_core.menu_education_core_config"
        action="action_education_faculty"
        sequence="50"
        groups="education_security.group_education_admin"/>

</odoo>
