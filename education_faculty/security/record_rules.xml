<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Faculty records are scoped to the current company -->
    <record id="rule_faculty_company" model="ir.rule">
        <field name="name">Faculty: company isolation</field>
        <field name="model_id" ref="model_education_faculty"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('education_security.group_education_admin')),
                                    (4, ref('education_security.group_education_teacher'))]"/>
    </record>
</odoo>
