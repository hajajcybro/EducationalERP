<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_library_usage">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Report Header -->
                    <div class="row mb-4">
                        <div class="col-8">
                            <h2 style="margin: 0; color: black;">Library Usage Report</h2>
                        </div>
                        <div class="col-4" style="text-align: right;">
                            <p style="margin: 0; font-size: 11px;">
                                <strong>Report Date:</strong> <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/><br/>
                                <strong>Generated By:</strong> <t t-esc="user.name"/>
                            </p>
                        </div>
                    </div>

                    <div >
                        <p style="margin: 0; font-size: 11px;">
                            <strong>Report Period:</strong>
                            <t t-esc="data.get('date_from', 'N/A')"/> to <t t-esc="data.get('date_to', 'N/A')"/><br/>

                            <t t-if="data.get('filters', {}).get('books')">
                                <strong>Books Selected:</strong> <t t-esc="len(data.get('filters', {}).get('books', []))"/> book(s)<br/>
                            </t>

                            <t t-if="data.get('filters', {}).get('members')">
                                <strong>Members Selected:</strong> <t t-esc="len(data.get('filters', {}).get('members', []))"/> member(s)<br/>
                            </t>

                            <t t-if="data.get('filters', {}).get('member_type')">
                                <strong>Member Type:</strong> <t t-esc="data.get('filters', {}).get('member_type')"/><br/>
                            </t>
                        </p>
                    </div>

                    <table class="table table-sm" style="width: 100%; border-collapse: collapse;" border="1">
                        <thead style="background-color: #aca2a0; text-align: left;">
                            <tr>
                                <th style="padding: 8px; font-size: 11px;">Transaction</th>
                                <th style="padding: 8px; font-size: 11px;">Book Title</th>
                                <th style="padding: 8px; font-size: 11px;">Member</th>
                                <th style="padding: 8px; font-size: 11px;">Type</th>
                                <th style="padding: 8px; font-size: 11px;">Issue Date</th>
                                <th style="padding: 8px; font-size: 11px;">Due Date</th>
                                <th style="padding: 8px; font-size: 11px;">Return Date</th>
                                <th style="padding: 8px; font-size: 11px; text-align: center;">Days Overdue</th>
                                <th style="padding: 8px; font-size: 11px; text-align: right;">Fine</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="transaction">
                                <tr>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('transaction_no', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('book_title', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('member_name', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('member_type', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('issue_date', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('due_date', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="transaction.get('return_date', '') or 'Not Returned'"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px; text-align: center;">
                                        <t t-esc="transaction.get('days_overdue', 0)"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px; text-align: right;">
                                        <t t-esc="'%.2f' % float(transaction.get('fine_amount', 0) or 0)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>