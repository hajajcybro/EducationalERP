<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_library_stock">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Report Header -->
                    <div class="row mb-4">
                        <div class="col-8">
                            <h2 style="margin: 0; color: black;">Library Stock Report</h2>
                        </div>
                        <div class="col-4" style="text-align: right;">
                            <p style="margin: 0; font-size: 11px;">
                                <strong>Report Date:</strong> <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/><br/>
                                <strong>Generated By:</strong> <t t-esc="user.name"/>
                            </p>
                        </div>
                    </div>

                    <div>
                        <p style="margin: 0; font-size: 11px;">
                            <t t-if="data.get('filters', {}).get('categories')">
                                <strong>Categories Selected:</strong> <t t-esc="len(data.get('filters', {}).get('categories', []))"/> category(ies)<br/>
                            </t>

                            <t t-if="data.get('filters', {}).get('books')">
                                <strong>Books Selected:</strong> <t t-esc="len(data.get('filters', {}).get('books', []))"/> book(s)<br/>
                            </t>

                            <t t-if="data.get('filters', {}).get('authors')">
                                <strong>Authors Filter:</strong> <t t-esc="data.get('filters', {}).get('authors')"/><br/>
                            </t>

                            <t t-if="data.get('filters', {}).get('publisher')">
                                <strong>Publisher Filter:</strong> <t t-esc="data.get('filters', {}).get('publisher')"/><br/>
                            </t>

                            <strong>Availability:</strong> <t t-esc="data.get('filters', {}).get('availability_filter', 'all')"/><br/>
                        </p>
                    </div>

                    <table class="table table-sm" style="width: 100%; border-collapse: collapse;" border="1">
                        <thead style="background-color: #aca2a0; text-align: left;">
                            <tr>
                                <th style="padding: 8px; font-size: 11px;">ISBN</th>
                                <th style="padding: 8px; font-size: 11px;">Book Title</th>
                                <th style="padding: 8px; font-size: 11px;">Authors</th>
                                <th style="padding: 8px; font-size: 11px;">Publisher</th>
                                <th style="padding: 8px; font-size: 11px;">Category</th>
                                <th style="padding: 8px; font-size: 11px; text-align: center;">Total Copies</th>
                                <th style="padding: 8px; font-size: 11px; text-align: center;">Available</th>
                                <th style="padding: 8px; font-size: 11px; text-align: center;">Issued</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="book">
                                <tr>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="book.get('isbn', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="book.get('title', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="book.get('authors', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="book.get('publisher', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px;">
                                        <t t-esc="book.get('category_name', '')"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px; text-align: center;">
                                        <t t-esc="book.get('copies_total', 0)"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px; text-align: center;">
                                        <t t-esc="book.get('copies_available', 0)"/>
                                    </td>
                                    <td style="padding: 6px; font-size: 10px; text-align: center;">
                                        <t t-esc="book.get('copies_issued', 0)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>