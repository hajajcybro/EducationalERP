<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron Job: Check and expire overdue reservations (runs every hour) -->
    <record id="ir_cron_check_expired_reservations" model="ir.cron">
        <field name="name">Library: Check Expired Reservations</field>
        <field name="model_id" ref="model_education_library_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expired_reservations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <!-- Cron Job: Send expiry reminders (runs daily at 9 AM) -->
    <record id="ir_cron_send_expiry_reminders" model="ir.cron">
        <field name="name">Library: Send Reservation Expiry Reminders</field>
        <field name="model_id" ref="model_education_library_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_expiry_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0, second=0)"/>
    </record>

    <!-- Cron Job: Send Due Date Reminders (runs daily at 9 AM) -->
    <record id="ir_cron_send_due_date_reminders" model="ir.cron">
        <field name="name">Library: Send Due Date Reminders</field>
        <field name="model_id" ref="model_education_library_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due_date_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0, second=0)"/>
    </record>

    <!-- Cron Job: Send Overdue Notifications (runs daily at 10 AM) -->
    <record id="ir_cron_send_overdue_notifications" model="ir.cron">
        <field name="name">Library: Send Overdue Notifications</field>
        <field name="model_id" ref="model_education_library_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_overdue_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=10, minute=0, second=0)"/>
    </record>

</odoo>