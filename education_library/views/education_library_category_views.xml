<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_library_category_tree" model="ir.ui.view">
        <field name="name">education.library.category.tree</field>
        <field name="model">education.library.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="book_count"/>
            </list>
        </field>
    </record>

    <record id="view_education_library_category_form" model="ir.ui.view">
        <field name="name">education.library.category.form</field>
        <field name="model">education.library.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="book_count"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Category description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_library_category_search" model="ir.ui.view">
        <field name="name">education.library.category.search</field>
        <field name="model">education.library.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <separator/>

                <group name="group_by">
                    <filter name="group_by_name"
                            string="Name"
                            context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_library_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">education.library.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>