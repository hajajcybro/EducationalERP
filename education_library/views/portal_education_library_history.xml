<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template id="portal_library_history">
    <t t-call="portal.portal_layout">

        <div class="container my-4">

            <h2 class="mb-4">My Library</h2>

            <!-- Fine Warning -->
            <t t-if="member.unpaid_fines > 0">
                <div class="alert alert-danger">
                    You have unpaid fines of ₹
                    <strong><t t-esc="member.unpaid_fines"/></strong>
                </div>
            </t>

            <!-- Member Summary -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card p-3">
                        <h6>Membership Expiry</h6>
                        <p><t t-esc="member.expiry_date"/></p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-3">
                        <h6>Books Issued</h6>
                        <p><t t-esc="member.books_issued"/></p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-3">
                        <h6>Active Reservations</h6>
                        <p><t t-esc="member.active_reservations_count"/></p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-3">
                        <h6>Total Transactions</h6>
                        <p><t t-esc="member.transaction_count"/></p>
                    </div>
                </div>
            </div>

            <!-- Tabs -->
            <ul class="nav nav-tabs" id="libraryTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#transactions">Transactions</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#reservations">Reservations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#invoices">Invoices</a>
                </li>
            </ul>

            <div class="tab-content mt-3">

                <!-- Transactions -->
                <div class="tab-pane fade show active" id="transactions">
                    <t t-if="transactions">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Book</th>
                                    <th>Issue</th>
                                    <th>Due</th>
                                    <th>Return</th>
                                    <th>Fine</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="transactions" t-as="t">
                                    <tr>
                                        <td><t t-esc="t.name"/></td>
                                        <td><t t-esc="t.book_id.title"/></td>
                                        <td><t t-esc="t.issue_date"/></td>
                                        <td><t t-esc="t.due_date"/></td>
                                        <td><t t-esc="t.return_date"/></td>
                                        <td>₹ <t t-esc="t.fine_amount"/></td>
                                        <td>
                                            <span class="badge"
                                                  t-att-class="'bg-success' if t.status == 'returned' else
                                                               'bg-warning' if t.status == 'issued' else
                                                               'bg-secondary'">
                                                <t t-esc="t.status"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="not transactions">
                        <p>No transactions found.</p>
                    </t>
                </div>

                <!-- Reservations -->
                <div class="tab-pane fade" id="reservations">
                    <t t-if="reservations">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Book</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="reservations" t-as="r">
                                    <tr>
                                        <td><t t-esc="r.name"/></td>
                                        <td><t t-esc="r.book_id.title"/></td>
                                        <td><t t-esc="r.status"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="not reservations">
                        <p>No reservations found.</p>
                    </t>
                </div>

                <!-- Invoices -->
                <div class="tab-pane fade" id="invoices">
                    <t t-if="invoices">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Number</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="invoices" t-as="inv">
                                    <tr>
                                        <td><t t-esc="inv.name"/></td>
                                        <td><t t-esc="inv.invoice_date"/></td>
                                        <td>₹ <t t-esc="inv.amount_total"/></td>
                                        <td><t t-esc="inv.payment_state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="not invoices">
                        <p>No invoices found.</p>
                    </t>
                </div>

            </div>

        </div>

    </t>
</template>

</odoo>