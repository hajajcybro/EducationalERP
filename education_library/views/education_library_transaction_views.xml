<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_library_transaction_tree" model="ir.ui.view">
        <field name="name">education.library.transaction.tree</field>
        <field name="model">education.library.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions" decoration-danger="status=='overdue'" decoration-info="status=='issued'">
                <field name="name"/>
                <field name="book_id"/>
                <field name="member_id"/>
                <field name="issue_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="days_overdue"/>
                <field name="fine_amount"/>
                <field name="renewal_count"/>
                <field name="status" widget="badge"
                       decoration-muted="status=='draft'"
                       decoration-success="status=='returned'"
                       decoration-info="status=='issued'"
                       decoration-warning="status=='overdue'"
                       decoration-danger="status=='lost'"/>
            </list>
        </field>
    </record>

    <record id="view_education_library_transaction_form" model="ir.ui.view">
        <field name="name">education.library.transaction.form</field>
        <field name="model">education.library.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <button name="action_issue_book" string="Issue" type="object"
                            class="oe_highlight" invisible="status in ['issued', 'overdue', 'returned', 'lost']"/>
                    <button name="action_renew" string="Renew" type="object"
                            class="btn-primary" invisible="status not in ['issued','overdue']"/>
                    <button name="action_return_book" string="Return" type="object"
                            class="oe_highlight" invisible="status in ['draft', 'returned', 'lost']"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object"
                            class="btn-danger" invisible="status in ['draft', 'returned', 'lost']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,issued,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="book_id"/>
                            <field name="member_id"/>
                            <field name="isbn"/>
                        </group>
                        <group>
                            <field name="issue_date" readonly="status == 'draft'"/>
                            <field name="due_date" readonly="status == 'draft'"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="days_overdue"/>
                            <field name="fine_per_day"/>
                            <field name="fine_amount"/>
                        </group>
                        <group>
                            <field name="renewal_count"/>
                            <field name="max_renewals"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_library_transaction_search" model="ir.ui.view">
        <field name="name">education.library.transaction.search</field>
        <field name="model">education.library.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <!-- QUICK SEARCH FIELDS -->
                <field name="name"/>
                <field name="book_id"/>
                <field name="member_id"/>
                <field name="isbn"/>
                <separator/>

                <!-- FILTERS -->
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('status','=','draft')]"/>
                <filter name="filter_issued"
                        string="Issued"
                        domain="[('status','=','issued')]"/>
                <filter name="filter_overdue"
                        string="Overdue"
                        domain="[('status','=','overdue')]"/>
                <filter name="filter_returned"
                        string="Returned"
                        domain="[('status','=','returned')]"/>
                <filter name="filter_lost"
                        string="Lost"
                        domain="[('status','=','lost')]"/>
                <separator/>
                <filter name="filter_from_reservation"
                        string="From Reservation"
                        domain="[('reservation_id','!=',False)]"/>
                <separator/>
                <filter name="filter_due_today"
                        string="Due Today"
                        domain="[('due_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_due_this_week"
                        string="Due This Week"
                        domain="[('due_date','&gt;=',context_today().strftime('%Y-%m-%d')),
                                ('due_date','&lt;=',(context_today()+datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>

                <!-- GROUP BY -->
                <group name="group_by">
                    <filter name="group_by_status"
                            string="Status"
                            context="{'group_by':'status'}"/>
                    <filter name="group_by_book"
                            string="Book"
                            context="{'group_by':'book_id'}"/>
                    <filter name="group_by_member"
                            string="Member"
                            context="{'group_by':'member_id'}"/>
                    <filter name="group_by_issue_date"
                            string="Issue Date"
                            context="{'group_by':'issue_date'}"/>
                    <filter name="group_by_due_date"
                            string="Due Date"
                            context="{'group_by':'due_date'}"/>
                    <filter name="group_by_return_date"
                            string="Return Date"
                            context="{'group_by':'return_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_library_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">education.library.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_education_library_transaction_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Books</field>
        <field name="res_model">education.library.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','=','overdue')]</field>
    </record>
</odoo>