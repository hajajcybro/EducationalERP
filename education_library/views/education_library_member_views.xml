<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_library_member_tree" model="ir.ui.view">
        <field name="name">education.library.member.tree</field>
        <field name="model">education.library.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="member_type" widget="badge"/>
                <field name="membership_date"/>
                <field name="expiry_date"/>
                <field name="books_issued"/>
                <field name="active_reservations_count"/>
                <field name="total_fines"/>
                <field name="unpaid_fines" decoration-danger="unpaid_fines &gt; 0"/>
                <field name="state" widget="badge"
                       decoration-muted="state=='draft'"
                       decoration-success="state=='active'"
                       decoration-danger="state=='expired'"/>
            </list>
        </field>
    </record>

    <record id="view_education_library_member_form" model="ir.ui.view">
        <field name="name">education.library.member.form</field>
        <field name="model">education.library.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <header>
                    <button name="action_register_member" string="Register" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_renew_membership" string="Renew" type="object"
                            class="oe_highlight" invisible="state != 'expired'"/>
                    <button name="action_create_fine_invoice" string="Pay Fines" type="object"
                            class="btn-warning"
                            invisible="unpaid_fines &lt;= 0"
                            icon="fa-money"
                            confirm="Create invoice for unpaid fines?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                        <button name="action_view_issued_transactions" type="object"
                                class="oe_stat_button" icon="fa-book-open">
                            <field name="books_issued" widget="statinfo" string="Issued"/>
                        </button>
                        <button name="action_view_reservations" type="object"
                                class="oe_stat_button" icon="fa-bookmark"
                                invisible="reservation_count == 0">
                            <field name="reservation_count" widget="statinfo" string="Reservations"/>
                        </button>
                        <button name="action_view_reservations" type="object"
                                class="oe_stat_button" icon="fa-clock-o"
                                invisible="active_reservations_count == 0">
                            <field name="active_reservations_count" widget="statinfo" string="Active Res."/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Unpaid Fines" bg_color="text-bg-warning"
                            invisible="unpaid_fines &lt;= 0"/>
                     <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_type"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="membership_date" readonly="state == 'draft'"/>
                            <field name="expiry_date" readonly="state == 'draft'"/>
                            <field name="is_expired" invisible="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="books_issued"/>
                            <field name="total_fines"/>
                            <field name="unpaid_fines"
                                   decoration-danger="unpaid_fines &gt; 0"
                                   style="font-weight: bold;"/>
                        </group>
                        <group>
                            <field name="active_reservations_count" string="Active Reservations"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="book_id"/>
                                    <field name="issue_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="fine_amount"/>
                                    <field name="is_from_reservation" string="From Res."/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reservations">
                            <field name="reservation_ids">
                                <list decoration-info="status=='pending'"
                                      decoration-success="status=='available'"
                                      decoration-muted="status in ['fulfilled','cancelled']">
                                    <field name="name"/>
                                    <field name="book_id"/>
                                    <field name="reservation_date"/>
                                    <field name="priority" string="Queue Position"/>
                                    <field name="available_date"/>
                                    <field name="expiry_date"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoices" invisible="invoice_count == 0">
                            <field name="invoice_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_library_member_search" model="ir.ui.view">
        <field name="name">education.library.member.search</field>
        <field name="model">education.library.member</field>
        <field name="arch" type="xml">
            <search string="Search Members">
                <!-- QUICK SEARCH FIELDS -->
                <field name="name"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone"/>
                <separator/>

                <!-- FILTERS -->
                <filter name="filter_active_members"
                        string="Active Members"
                        domain="[('state','=','active')]"/>
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_expired"
                        string="Expired"
                        domain="[('state','=','expired')]"/>
                <separator/>
                <filter name="filter_student"
                        string="Students"
                        domain="[('member_type','=','student')]"/>
                <filter name="filter_faculty"
                        string="Faculty"
                        domain="[('member_type','=','faculty')]"/>
                <filter name="filter_staff"
                        string="Staff"
                        domain="[('member_type','=','staff')]"/>
                <filter name="filter_external"
                        string="External"
                        domain="[('member_type','=','external')]"/>
                <separator/>
                <filter name="filter_archived"
                        string="Archived"
                        domain="[('active','=',False)]"/>
                <separator/>

                <!-- GROUP BY -->
                <group name="group_by">
                    <filter name="group_by_member_type"
                            string="Member Type"
                            context="{'group_by':'member_type'}"/>
                    <filter name="group_by_state"
                            string="Status"
                            context="{'group_by':'state'}"/>
                    <filter name="group_by_membership_date"
                            string="Membership Date"
                            context="{'group_by':'membership_date'}"/>
                    <filter name="group_by_expiry_date"
                            string="Expiry Date"
                            context="{'group_by':'expiry_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">education.library.member</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>