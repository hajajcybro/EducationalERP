<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_library_overdue_wizard_form" model="ir.ui.view">
        <field name="name">library.overdue.wizard.form</field>
        <field name="model">library.overdue.wizard</field>
        <field name="arch" type="xml">
            <form string="Library Overdue Books Report">

                <group string="Filters" name="filters">
                    <group>
                        <field name="book_ids" widget="many2many_tags"
                               placeholder="Leave empty for all books"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="member_ids" widget="many2many_tags"
                               placeholder="Leave empty for all members"
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <group string="Date Range" name="date_range">
                    <group>
                        <field name="date_from" placeholder="Leave empty for all dates"/>
                        <field name="date_to" placeholder="Leave empty for all dates"/>
                    </group>
                </group>

                <footer>
                    <button name="action_generate_pdf" string="PDF" type="object"
                            class="oe_highlight"/>
                    <button name="action_generate_xlsx" string="XLSX" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_overdue_wizard" model="ir.actions.act_window">
        <field name="name">Overdue Report</field>
        <field name="res_model">library.overdue.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>