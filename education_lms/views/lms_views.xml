<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         edu.lms.course.category — Category Views
    ══════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_lms_course_category_form" model="ir.ui.view">
        <field name="name">edu.lms.course.category.form</field>
        <field name="model">edu.lms.course.category</field>
        <field name="arch" type="xml">
            <form string="Course Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="course_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_lms_course_category_list" model="ir.ui.view">
        <field name="name">edu.lms.course.category.list</field>
        <field name="model">edu.lms.course.category</field>
        <field name="arch" type="xml">
            <list string="Course Categories">
                <field name="name"/>
                <field name="course_count"/>
            </list>
        </field>
    </record>

    <record id="action_edu_lms_course_category" model="ir.actions.act_window">
        <field name="name">Course Categories</field>
        <field name="res_model">edu.lms.course.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         education.lms.course — Course Views
    ══════════════════════════════════════════════════════════════════════ -->

    <record id="view_education_lms_course_form" model="ir.ui.view">
        <field name="name">education.lms.course.form</field>
        <field name="model">education.lms.course</field>
        <field name="arch" type="xml">
            <form string="LMS Course">
                <header>
                    <button name="action_publish"
                            string="Publish"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_archive_course"
                            string="Archive"
                            type="object"
                            invisible="state == 'archived'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <field name="thumbnail" widget="image"
                           class="oe_avatar" options="{'preview_image': 'thumbnail'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Course Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="teacher_id"/>
                            <field name="enrollment_mode"/>
                        </group>
                        <group>
                            <field name="lesson_count" readonly="1"/>
                            <field name="enrollment_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="info">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Lessons" name="lessons">
                            <field name="lesson_ids" context="{'default_course_id': active_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="lesson_type"/>
                                    <field name="duration_mins"/>
                                    <field name="content_url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Quizzes" name="quizzes">
                            <field name="quiz_ids"
                                   context="{'default_course_id': active_id}"
                                   domain="[('course_id','=',active_id)]">
                                <list>
                                    <field name="title"/>
                                    <field name="question_count"/>
                                    <field name="pass_marks"/>
                                    <field name="time_limit_mins"/>
                                    <field name="max_attempts"/>
                                </list>
                            </field>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids" context="{'default_course_id': active_id}">
                                <list>
                                    <field name="student_id"/>
                                    <field name="enrolled_date"/>
                                    <field name="completion_pct"
                                           widget="progressbar"/>
                                    <field name="state"/>
                                    <field name="certificate_issued"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_lms_course_list" model="ir.ui.view">
        <field name="name">education.lms.course.list</field>
        <field name="model">education.lms.course</field>
        <field name="arch" type="xml">
            <list string="LMS Courses">
                <field name="title"/>
                <field name="category_id"/>
                <field name="teacher_id"/>
                <field name="enrollment_mode"/>
                <field name="lesson_count"/>
                <field name="enrollment_count"/>
                <field name="state"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"
                       decoration-warning="state == 'draft'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_education_lms_course_kanban" model="ir.ui.view">
        <field name="name">education.lms.course.kanban</field>
        <field name="model">education.lms.course</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="title"/>
                <field name="teacher_id"/>
                <field name="enrollment_count"/>
                <field name="thumbnail"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <field name="thumbnail" widget="image"
                                   options="{'zoom': True, 'preview_image': 'thumbnail'}"
                                   class="o_image_64_cover"/>
                        </div>
                        <div class="o_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="title"/>
                            </strong>
                            <div class="o_kanban_tags_section">
                                <field name="teacher_id"/>
                            </div>
                            <div>
                                <span>Enrollments: </span>
                                <field name="enrollment_count"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'published'"
                                           decoration-muted="state == 'archived'"
                                           decoration-warning="state == 'draft'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_education_lms_course_search" model="ir.ui.view">
        <field name="name">education.lms.course.search</field>
        <field name="model">education.lms.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="title"/>
                <field name="category_id"/>
                <field name="teacher_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Published" name="published" domain="[('state','=','published')]"/>
                <filter string="Archived" name="archived" domain="[('state','=','archived')]"/>
                <filter string="Open Enrollment" name="open" domain="[('enrollment_mode','=','open')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_lms_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">education.lms.course</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_education_lms_course_search"/>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first LMS Course!
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         education.lms.lesson — Lesson Views
    ══════════════════════════════════════════════════════════════════════ -->

    <record id="view_education_lms_lesson_form" model="ir.ui.view">
        <field name="name">education.lms.lesson.form</field>
        <field name="model">education.lms.lesson</field>
        <field name="arch" type="xml">
            <form string="Lesson">
                <sheet>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="title"/>
                            <field name="lesson_type"/>
                            <field name="sequence"/>
                            <field name="duration_mins"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="content_url"/>
                        </group>
                    </group>
                    <!-- Inline content preview for URL-type lessons -->
                    <group string="Content Preview"
                           invisible="lesson_type not in ['url','video']">
                        <div colspan="2" invisible="not content_url">
                            <iframe t-att-src="content_url"
                                    width="100%"
                                    height="480"
                                    frameborder="0"
                                    allowfullscreen="1"
                                    style="border:1px solid #dee2e6; border-radius:4px;"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_lms_lesson_list" model="ir.ui.view">
        <field name="name">education.lms.lesson.list</field>
        <field name="model">education.lms.lesson</field>
        <field name="arch" type="xml">
            <list string="Lessons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="course_id"/>
                <field name="title"/>
                <field name="lesson_type"/>
                <field name="duration_mins"/>
                <field name="content_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_education_lms_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">education.lms.lesson</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         edu.lms.quiz — Quiz Views
    ══════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_lms_quiz_form" model="ir.ui.view">
        <field name="name">edu.lms.quiz.form</field>
        <field name="model">edu.lms.quiz</field>
        <field name="arch" type="xml">
            <form string="Quiz">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Quiz Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="pass_marks"/>
                            <field name="time_limit_mins"/>
                        </group>
                        <group>
                            <field name="max_attempts"/>
                            <field name="question_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_text"/>
                                    <field name="question_type"/>
                                    <field name="correct_answer"
                                           invisible="question_type == 'mcq'"/>
                                    <field name="marks"/>
                                </list>
                                <form string="Question">
                                    <group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="question_text"/>
                                            <field name="question_type"/>
                                            <field name="marks"/>
                                        </group>
                                        <group>
                                            <field name="correct_answer"
                                                   invisible="question_type == 'mcq'"
                                                   placeholder="e.g. 'true', 'false', or expected text"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Options (MCQ)"
                                              invisible="question_type != 'mcq'">
                                            <field name="option_ids">
                                                <list editable="bottom">
                                                    <field name="option_text"/>
                                                    <field name="is_correct"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_lms_quiz_list" model="ir.ui.view">
        <field name="name">edu.lms.quiz.list</field>
        <field name="model">edu.lms.quiz</field>
        <field name="arch" type="xml">
            <list string="Quizzes">
                <field name="title"/>
                <field name="course_id"/>
                <field name="question_count"/>
                <field name="pass_marks"/>
                <field name="time_limit_mins"/>
                <field name="max_attempts"/>
            </list>
        </field>
    </record>

    <record id="action_edu_lms_quiz" model="ir.actions.act_window">
        <field name="name">Quizzes</field>
        <field name="res_model">edu.lms.quiz</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         edu.lms.enrollment — Enrollment Views
    ══════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_lms_enrollment_form" model="ir.ui.view">
        <field name="name">edu.lms.enrollment.form</field>
        <field name="model">edu.lms.enrollment</field>
        <field name="arch" type="xml">
            <form string="LMS Enrollment">
                <header>
                    <button name="action_mark_complete"
                            string="Mark as Completed"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'enrolled'"/>
                    <button name="action_drop"
                            string="Drop"
                            type="object"
                            invisible="state != 'enrolled'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="enrolled,completed,dropped"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="enrolled_date"/>
                        </group>
                        <group>
                            <field name="completion_pct" widget="progressbar"/>
                            <field name="certificate_issued"/>
                        </group>
                    </group>
                    <!-- Certificate report button (only shown when completed) -->
                    <div invisible="state != 'completed'">
                        <button name="action_print_certificate"
                                string="Print Certificate"
                                type="object"
                                class="btn-secondary"
                                icon="fa-print"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_lms_enrollment_list" model="ir.ui.view">
        <field name="name">edu.lms.enrollment.list</field>
        <field name="model">edu.lms.enrollment</field>
        <field name="arch" type="xml">
            <list string="LMS Enrollments">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrolled_date"/>
                <field name="completion_pct" widget="progressbar"/>
                <field name="state"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'dropped'"
                       widget="badge"/>
                <field name="certificate_issued"/>
            </list>
        </field>
    </record>

    <record id="action_edu_lms_enrollment" model="ir.actions.act_window">
        <field name="name">LMS Enrollments</field>
        <field name="res_model">edu.lms.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No enrollments yet.
            </p>
        </field>
    </record>

</odoo>
