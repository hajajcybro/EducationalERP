<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Grant Education Administrators full access to the Fleet app so they
         can manage school vehicles (fleet.vehicle) from Education > Transport.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="education_security.group_education_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
    </record>

</odoo>
