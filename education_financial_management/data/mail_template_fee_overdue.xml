<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         Mail template: overdue fee reminder (S5-T05)
         Sent by edu.fee.overdue.cron to student / guardian
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="mail_template_fee_overdue" model="mail.template">
        <field name="name">Fee Overdue Reminder</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Fee Payment Overdue — {{ object.enrollment_id.student_name }}</field>
        <field name="email_to">{{
            object.enrollment_id.guardian_partner_id.email
            or object.enrollment_id.student_partner_id.email
            or object.partner_id.email
        }}</field>
        <field name="email_from">{{ (user.email_formatted or user.login) }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 640px; margin: auto; border: 1px solid #e0e0e0; border-radius: 6px; overflow: hidden;">

    <!-- Header -->
    <div style="background: #d9534f; padding: 24px 32px;">
        <h2 style="color: #fff; margin: 0;">Fee Payment Overdue</h2>
    </div>

    <!-- Body -->
    <div style="padding: 24px 32px;">
        <p>Dear <strong>{{ object.enrollment_id.guardian_partner_id.name or object.enrollment_id.student_name or object.partner_id.name }}</strong>,</p>

        <p>This is a reminder that the following fee invoice is <strong>overdue</strong>.</p>

        <table style="width:100%; border-collapse:collapse; margin: 16px 0;">
            <tr style="background:#f5f5f5;">
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Invoice No.</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">{{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Student</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">{{ object.enrollment_id.student_name }}</td>
            </tr>
            <tr style="background:#f5f5f5;">
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Fee Plan</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">{{ object.enrollment_id.fee_plan_id.name }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Due Date</td>
                <td style="padding:8px 12px; border:1px solid #ddd; color:#d9534f;">
                    <strong>{{ object.invoice_date_due }}</strong>
                </td>
            </tr>
            <tr style="background:#f5f5f5;">
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Total Amount</td>
                <td style="padding:8px 12px; border:1px solid #ddd;">
                    {{ object.currency_id.symbol }} {{ "%.2f"|format(object.amount_total) }}
                </td>
            </tr>
            <tr>
                <td style="padding:8px 12px; border:1px solid #ddd; font-weight:bold;">Amount Outstanding</td>
                <td style="padding:8px 12px; border:1px solid #ddd; color:#d9534f;">
                    <strong>{{ object.currency_id.symbol }} {{ "%.2f"|format(object.amount_residual) }}</strong>
                </td>
            </tr>
        </table>

        <p>Please make the payment at the earliest to avoid any late penalties.</p>
        <p>If you have already paid, kindly disregard this notice and contact the accounts office with proof of payment.</p>

        <p style="margin-top:24px;">
            Regards,<br/>
            <strong>Accounts Department</strong><br/>
            {{ user.company_id.name }}
        </p>
    </div>

    <!-- Footer -->
    <div style="background:#f9f9f9; padding:12px 32px; border-top:1px solid #e0e0e0; font-size:11px; color:#888;">
        This is an automated reminder. Please do not reply to this email.
    </div>

</div>
        ]]></field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
