<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_financial_alerts" inherit_id="portal.portal_my_home">
        <!-- We insert the alerts right before the main container of the cards -->
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="before">
            <t t-if="financial_alert_messages">
                <div class="container mt-4 mb-2">
                    <t t-foreach="financial_alert_messages" t-as="msg">
                        <div class="alert alert-info alert-dismissible fade show shadow-sm border-0" role="alert">
                            <i class="fa fa-bell me-2 text-primary"/>
                            <strong>Financial Alert: </strong> <t t-esc="msg"/>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </t>
                </div>
            </t>

        </xpath>
    </template>
</odoo>

