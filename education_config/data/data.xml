<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Default Institution Profile — created once at install.
        noupdate="1" ensures this is never overwritten by a module upgrade.
        Administrators can edit it via Configuration > Institution Profile.
    -->
    <record id="default_institution_profile" model="institution.profile">
        <field name="name">My Institution</field>
        <field name="short_name">EDU</field>
        <field name="institution_type">university</field>
        <field name="timezone">UTC</field>
        <field name="branding_color">#1F3864</field>
        <field name="branding_color_secondary">#2E75B6</field>
        <field name="academic_year_start_month">7</field>
        <field name="working_days">5</field>
        <field name="max_periods_per_day">8</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="currency_id" ref="base.USD"/>
    </record>
</odoo>
